<style>
.goa-search{display:block;width:100%;max-width:1100px;min-width:0;margin:0 auto;padding:24px 16px;box-sizing:border-box;}
.goa-search *{min-width:0;}
.goa-search-results,.goa-search-card{width:100%;max-width:100%;box-sizing:border-box;}
.goa-search-card{overflow-wrap:anywhere;}
html[dir="rtl"] .goa-search{text-align:start;}
@media(max-width:720px){.goa-search{width:100%;max-width:100%;padding:18px 12px;}.goa-search-controls{grid-template-columns:minmax(0,1fr);}.goa-search-box{min-width:0;}}
.goa-search h1{margin-bottom:8px}
.goa-search-intro{margin-bottom:18px}
.goa-search-box{width:100%;padding:14px 16px;border:1px solid #ccc;border-radius:10px;font-size:1rem;box-sizing:border-box}
.goa-search-controls{display:grid;grid-template-columns:1fr 220px;gap:10px;margin:12px 0 18px}
.goa-search-results{display:grid;gap:12px}
.goa-search-card{border:1px solid #ddd;border-radius:10px;padding:15px;background:#fff}
.goa-search-card h2{font-size:1.05rem;margin:0 0 6px}
.goa-search-card a{color:inherit;text-decoration:none}
.goa-search-card a:hover{text-decoration:underline}
.goa-search-meta{font-size:.85rem;opacity:.75;margin-bottom:7px}
.goa-search-summary{margin:0}
.goa-search-empty{padding:24px;border:1px dashed #bbb;border-radius:10px;text-align:center}
@media(max-width:650px){.goa-search-controls{grid-template-columns:1fr}}
</style>

<div class="goa-search">
  <h1 data-i18n="search.title">Global Agricultural Search</h1>
  <p class="goa-search-intro" data-i18n="search.intro">Search across GoOrganicAfrica resources, news, opportunities, markets, machinery, suppliers, training, events, eBooks and blog.</p>

  <div class="goa-search-controls">
    <input id="goa-global-search" class="goa-search-box" type="search" placeholder="Search agriculture, maize, Nigeria, finance, machinery, training..." data-i18n-placeholder="search.placeholder" autocomplete="off" aria-label="Search GoOrganicAfrica" data-i18n-aria-label="search.ariaLabel">
    <select id="goa-search-type" class="goa-search-box" aria-label="Filter search results" data-i18n-aria-label="search.filterLabel">
      <option value="" data-i18n="search.allSections">All sections</option>
      <option value="Resource" data-i18n="search.resources">Resources</option>
      <option value="News" data-i18n="search.news">Agricultural News</option>
      <option value="Opportunity" data-i18n="search.opportunities">Opportunities</option>
      <option value="Market" data-i18n="search.markets">Markets</option>
      <option value="Service" data-i18n="search.services">Services & Machinery</option>
      <option value="eBook" data-i18n="search.ebooks">eBooks</option>
      <option value="Blog" data-i18n="search.blog">Blog</option>
    </select>
  </div>

  <p id="goa-search-count" aria-live="polite"></p>
  <div id="goa-search-connections" style="display:none;margin:16px 0 24px;">
    <div style="border:1px solid var(--line);border-radius:12px;padding:18px;background:var(--paper);">
      <h2 style="margin-top:0;" data-i18n="search.connectedTitle">Connected Agricultural Intelligence</h2>
      <p style="margin-bottom:14px;" data-i18n="search.connectedIntro">Use the same topic or country across different GoOrganicAfrica sections to move from information to action.</p>
      <div id="goa-connection-cards" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px;"></div>
    </div>
  </div>
  <div id="goa-search-results" class="goa-search-results"></div>

  <noscript><p class="goa-search-empty" data-i18n="search.noScript">Please enable JavaScript to use Global Search.</p></noscript>

  <div id="goa-search-source" hidden>
    {% for country in agriculturalResourcesAll.countries %}
      {% for category in agriculturalResourcesAll.categories %}
        {% for r in country.records[category] %}
          {% if (r.status == "official" or r.status == "published" or r.status == "verified") and (not r.lifecycle or r.lifecycle == "current") and r.title %}
            <article data-type="Resource" data-country-code="{{ country.code }}" data-title="{{ r.title }}" data-summary="{{ r.description or r.summary or '' }}" data-title-fr="{{ r.localized.fr.title or '' }}" data-summary-fr="{{ r.localized.fr.summary or r.localized.fr.description or '' }}" data-title-ar="{{ r.localized.ar.title or '' }}" data-summary-ar="{{ r.localized.ar.summary or r.localized.ar.description or '' }}" data-title-pt="{{ r.localized.pt.title or '' }}" data-summary-pt="{{ r.localized.pt.summary or r.localized.pt.description or '' }}" data-title-sw="{{ r.localized.sw.title or '' }}" data-summary-sw="{{ r.localized.sw.summary or r.localized.sw.description or '' }}" data-keywords="{{ r.search_terms or '' }} {{ r.keywords or '' }} {{ r.tags or '' }} {{ r.slug or '' }}" data-meta="{{ country.name or country.country or country.code }} · {{ category }} · {{ r.source or '' }}" data-url="{{ r.url or r.source_url or '/agriculture-resources/' }}"></article>
          {% endif %}
        {% endfor %}
      {% endfor %}
    {% endfor %}
    {% for country in agriculturalNewsMerged.countries %}
      {% for r in country.articles %}
        {% if (r.status == "official" or r.status == "published" or r.status == "verified") and (not r.lifecycle or r.lifecycle == "current") and r.url %}
          <article data-type="News" data-title="{{ r.title }}" data-summary="{{ r.summary or '' }}" data-title-fr="{{ r.localized.fr.title or '' }}" data-summary-fr="{{ r.localized.fr.summary or '' }}" data-title-ar="{{ r.localized.ar.title or '' }}" data-summary-ar="{{ r.localized.ar.summary or '' }}" data-title-pt="{{ r.localized.pt.title or '' }}" data-summary-pt="{{ r.localized.pt.summary or '' }}" data-title-sw="{{ r.localized.sw.title or '' }}" data-summary-sw="{{ r.localized.sw.summary or '' }}" data-keywords="{{ r.search_terms or '' }} {{ r.keywords or '' }}" data-meta="{{ country.name or country.country or country.code }} · {{ r.category or '' }} · {{ r.source or '' }}" data-url="{{ r.url }}"></article>
        {% endif %}
      {% endfor %}
    {% endfor %}
    {% for r in agriculturalOpportunities.records %}
      {% if (r.status == "open" or r.status == "active") and (not r.lifecycle or r.lifecycle == "current") %}
        <article data-type="Opportunity" data-title="{{ r.title }}" data-summary="{{ r.summary or r.description or '' }}" data-title-fr="{{ r.localized.fr.title or '' }}" data-summary-fr="{{ r.localized.fr.summary or '' }}" data-title-ar="{{ r.localized.ar.title or '' }}" data-summary-ar="{{ r.localized.ar.summary or '' }}" data-title-pt="{{ r.localized.pt.title or '' }}" data-summary-pt="{{ r.localized.pt.summary or '' }}" data-title-sw="{{ r.localized.sw.title or '' }}" data-summary-sw="{{ r.localized.sw.summary or '' }}" data-keywords="{{ r.search_terms or '' }} {{ r.keywords or '' }} {{ r.tags or '' }}" data-meta="{{ r.country or r.country_code or '' }} · {{ r.type or r.category or '' }} · {{ r.provider or r.source or '' }}" data-url="{{ r.application_url or r.source_url or r.url or '/opportunities/' }}"></article>
      {% endif %}
    {% endfor %}
    {% for r in agriculturalMarkets.records %}
      <article data-type="Market" data-title="{{ r.commodity or 'Market information' }}{% if r.market %} — {{ r.market }}{% endif %}" data-summary="{{ r.note or r.description or '' }}" data-title-fr="{{ r.localized.fr.title or '' }}" data-summary-fr="{{ r.localized.fr.summary or '' }}" data-title-ar="{{ r.localized.ar.title or '' }}" data-summary-ar="{{ r.localized.ar.summary or '' }}" data-title-pt="{{ r.localized.pt.title or '' }}" data-summary-pt="{{ r.localized.pt.summary or '' }}" data-title-sw="{{ r.localized.sw.title or '' }}" data-summary-sw="{{ r.localized.sw.summary or '' }}" data-keywords="{{ r.search_terms or '' }} {{ r.keywords or '' }} {{ r.commodity or '' }}" data-meta="{{ r.country or r.country_code or '' }} · {{ r.price_type or '' }}{% if r.observed_date %} · {{ r.observed_date }}{% endif %}" data-url="{{ r.source_url or r.url or '/markets/' }}"></article>
    {% endfor %}
    {% for r in agriculturalServices.records %}
      <article data-type="Service" data-title="{{ r.title }}" data-summary="{{ r.summary or '' }}" data-title-fr="{{ r.localized.fr.title or '' }}" data-summary-fr="{{ r.localized.fr.summary or '' }}" data-title-ar="{{ r.localized.ar.title or '' }}" data-summary-ar="{{ r.localized.ar.summary or '' }}" data-title-pt="{{ r.localized.pt.title or '' }}" data-summary-pt="{{ r.localized.pt.summary or '' }}" data-title-sw="{{ r.localized.sw.title or '' }}" data-summary-sw="{{ r.localized.sw.summary or '' }}" data-keywords="{{ r.search_terms or '' }} {{ r.keywords or '' }} {{ r.tags or '' }}" data-meta="{{ r.country or r.country_code or '' }} · {{ r.category or '' }} · {{ r.provider or '' }}" data-url="{{ r.url or '/agricultural-services/' }}"></article>
    {% endfor %}
    {% for item in collections.ebooks %}
      {% if item.data.active !== false and (item.data.translation_status or 'published') !== 'in_review' %}
        <article data-type="eBook" data-title="{{ item.data.title or item.data.name or '' }}" data-summary="{{ item.data.tagline or item.data.description or item.data.audience or '' }}" data-title-fr="{{ item.data.localized.fr.title or '' }}" data-summary-fr="{{ item.data.localized.fr.summary or item.data.localized.fr.description or '' }}" data-title-ar="{{ item.data.localized.ar.title or '' }}" data-summary-ar="{{ item.data.localized.ar.summary or item.data.localized.ar.description or '' }}" data-title-pt="{{ item.data.localized.pt.title or '' }}" data-summary-pt="{{ item.data.localized.pt.summary or item.data.localized.pt.description or '' }}" data-title-sw="{{ item.data.localized.sw.title or '' }}" data-summary-sw="{{ item.data.localized.sw.summary or item.data.localized.sw.description or '' }}" data-keywords="{{ item.data.search_terms or '' }} {{ item.data.keywords or '' }} {{ item.data.tags or '' }} {{ item.data.slug or item.fileSlug or '' }} {{ item.data.audience or '' }}" data-meta="{{ item.data.category or '' }} · eBook" data-url="{{ item.url }}"></article>
      {% endif %}
    {% endfor %}
    {% for item in collections.posts %}
      {% if item.data.active !== false and (item.data.translation_status or 'published') !== 'in_review' %}
        <article data-type="Blog" data-title="{{ item.data.title or '' }}" data-summary="{{ item.data.description or item.data.excerpt or '' }}" data-title-fr="{{ item.data.localized.fr.title or '' }}" data-summary-fr="{{ item.data.localized.fr.summary or item.data.localized.fr.description or '' }}" data-title-ar="{{ item.data.localized.ar.title or '' }}" data-summary-ar="{{ item.data.localized.ar.summary or item.data.localized.ar.description or '' }}" data-title-pt="{{ item.data.localized.pt.title or '' }}" data-summary-pt="{{ item.data.localized.pt.summary or item.data.localized.pt.description or '' }}" data-title-sw="{{ item.data.localized.sw.title or '' }}" data-summary-sw="{{ item.data.localized.sw.summary or item.data.localized.sw.description or '' }}" data-keywords="{{ item.data.search_terms or '' }} {{ item.data.keywords or '' }} {{ item.data.tags or '' }} {{ item.data.slug or item.fileSlug or '' }}" data-meta="{{ item.data.category or '' }} · Blog · {{ item.data.language or 'en' }}" data-url="{{ item.url }}"></article>
      {% endif %}
    {% endfor %}
  </div>
</div>

