---
layout: layouts/base.njk
title: "GoOrganicAfrica — Free Farm Profit Calculator & Organic Farming Guides for Africa"
description: "Free farm profit calculator for Nigerian and African farmers. Calculate farming costs, revenue, profit and ROI across {{ site.calculator.enterpriseCount }} farming enterprises in {{ site.calculator.countryCount }} African countries. Expert organic farming guides on hydroponic fodder, mushroom farming, black soldier fly farming and cassava production."
permalink: "/"
---

<!-- HERO: Tool first, SaaS positioning -->
<section class="hero" style="background: linear-gradient(135deg, var(--green-deep) 0%, var(--green-mid) 100%); color: var(--white); padding: 64px 0 80px;">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow" style="color: var(--gold);" data-i18n="home.eyebrow">Free Farming Tool</span>
      <h1 style="color: var(--white);" data-i18n="home.headline">Know Your Farm Profit Before You Plant</h1>
      <p class="lede" style="color: var(--white); max-width: 52ch;">
        <span data-i18n="home.description">Calculate your cost of production, expected revenue, profit, ROI and break-even point — free, across Nigeria and Africa, in your own currency.</span>
      </p>
      <ul class="hero-bullets" style="color: var(--white);">
        <li id="hp-country-line" data-i18n="home.countryLine" data-i18n-vars='{"count":"{{ site.calculator.countryCount }}"}'>Covering {{ site.calculator.countryCount }} African countries{% if site.data.featuredCountryNames | length %} — including {{ site.data.featuredCountryNames | join(", ") }}{% if site.calculator.countryCount > 3 %} &amp; more{% endif %}{% endif %}</li>
        <li data-i18n="home.bullet1">Crops, livestock &amp; more — continuously expanding</li>
        <li data-i18n="home.bullet2">Enter farm size in acres, plots or hectares</li>
        <li data-i18n="home.bullet3">Override any figure with your own local numbers</li>
        <li data-i18n="home.bullet4">Conservative, Expected &amp; Optimistic profit scenarios</li>
      </ul>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/farm-profit-calculator/" data-i18n="home.calculateCta" style="background:var(--gold);color:var(--green-deep);box-shadow:3px 3px 0 rgba(0,0,0,0.3);">
          &#9654; Calculate My Farm Profit
        </a>
        <a class="btn btn-outline" href="/ebooks/" data-i18n="home.guidesCta" style="border-color:rgba(255,255,255,0.5);color:var(--white);">Browse Farming Guides</a>
      </div>
    </div>

    <!-- Calculator preview card -->
    <a href="/farm-profit-calculator/" style="text-decoration:none;">
      <div class="packet" style="background:var(--white); box-shadow: 8px 8px 0 rgba(0,0,0,0.25);">
        <div class="packet-header">
          <span class="packet-batch" style="color:var(--soil);" data-i18n="home.freeTool">FREE TOOL</span>
          <span style="font-size:2.2rem;">&#127807;</span>
        </div>
        <h2 class="packet-title" data-i18n="home.calculatorTitle">Farm Profit Calculator Africa</h2>
        <p class="packet-tagline" data-i18n="home.calculatorTagline">Plan Your Farm. Calculate Your Profit.</p>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin: 16px 0;">
          <div style="background:var(--sage-light);border-radius:8px;padding:10px;text-align:center;">
            <div style="font-family:var(--font-label);font-size:1.1rem;font-weight:800;color:var(--green-deep);">{{ site.calculator.cropCount }}</div>
            <div style="font-size:0.72rem;color:var(--ink-soft);" data-i18n="home.cropsGrowing">Crops & growing</div>
          </div>
          <div style="background:var(--sage-light);border-radius:8px;padding:10px;text-align:center;">
            <div style="font-family:var(--font-label);font-size:1.1rem;font-weight:800;color:var(--green-deep);">{{ site.calculator.livestockCount }}</div>
            <div style="font-size:0.72rem;color:var(--ink-soft);" data-i18n="home.livestockGrowing">Livestock & growing</div>
          </div>
        </div>
        <div class="packet-footer">
          <span class="packet-price" style="color:var(--green-mid);" data-i18n="home.free">100% Free</span>
          <span class="btn btn-sm btn-primary" data-i18n="home.openCalculator">Open Calculator</span>
        </div>
      </div>
    </a>
  </div>
</section>

<!-- TRUST STRIP -->
<section class="section section-alt" style="padding: 32px 0;">
  <div class="container">
    <div class="trust-strip">
      <div class="trust-item">
        <span class="num">{{ site.calculator.enterpriseCount }}</span>
        <span class="label" data-i18n="home.enterprises">Farming enterprises</span>
      </div>
      <div class="trust-item">
        <span class="num">{{ site.calculator.directoryCountryCount }}</span>
        <span class="label" data-i18n="home.directoryCountries">African countries in directory</span>
      </div>
      <div class="trust-item">
        <span class="num">{{ site.calculator.countryCount }}</span>
        <span class="label" data-i18n="home.readyCountries">Calculator-ready countries</span>
      </div>
      <div class="trust-item">
        <span class="num">{{ site.calculator.regionCount }}</span>
        <span class="label" data-i18n="home.regions">Active states / regions / provinces</span>
      </div>
      <div class="trust-item">
        <span class="num">100%</span>
        <span class="label" data-i18n="home.freeToUse">Free to use</span>
      </div>
    </div>
    <p style="text-align:center;margin:14px 0 0;color:var(--ink-soft);font-size:0.82rem;" data-i18n="home.directoryNote">Country directory records can be expanded through the CMS. Calculator-ready countries are counted separately so unavailable regional or price data is never presented as verified data.</p>
  </div>
</section>

<!-- HOW IT WORKS: 3-step SaaS explainer -->
<section class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow" data-i18n="home.howItWorks">How it works</span>
      <h2 data-i18n="home.threeSteps">Three Steps to Your Farm Profit Report</h2>
      <p class="lede" data-i18n="home.noSignup">No sign-up. No payment. Just your numbers.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;">
      <div style="text-align:center;padding:24px 16px;">
        <div style="font-size:2.4rem;margin-bottom:12px;">&#127758;</div>
        <h3 style="font-size:1.1rem;margin-bottom:8px;" data-i18n="home.step1Title">1. Pick Your Country & Crop</h3>
        <p style="font-size:0.9rem;color:var(--ink-soft);margin:0;" data-i18n="home.step1Body">Select your African country, your region, and the crop or livestock you plan to farm. Currency and data adjust automatically.</p>
      </div>
      <div style="text-align:center;padding:24px 16px;border-left:1px solid var(--line);border-right:1px solid var(--line);">
        <div style="font-size:2.4rem;margin-bottom:12px;">&#9999;&#65039;</div>
        <h3 style="font-size:1.1rem;margin-bottom:8px;" data-i18n="home.step2Title">2. Enter Your Farm Details</h3>
        <p style="font-size:0.9rem;color:var(--ink-soft);margin:0;" data-i18n="home.step2Body">Choose farm size in acres, plots or hectares. Use our researched cost and price estimates, or enter your own local figures.</p>
      </div>
      <div style="text-align:center;padding:24px 16px;">
        <div style="font-size:2.4rem;margin-bottom:12px;">&#128200;</div>
        <h3 style="font-size:1.1rem;margin-bottom:8px;" data-i18n="home.step3Title">3. Get Your Profit Report</h3>
        <p style="font-size:0.9rem;color:var(--ink-soft);margin:0;" data-i18n="home.step3Body">See your total investment, expected revenue, estimated profit, ROI, and break-even price — plus 3 scenarios and personalised advice.</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:32px;">
      <a class="btn btn-primary" href="/farm-profit-calculator/" data-i18n="home.tryCalculator">Try the Calculator — It's Free</a>
    </div>
  </div>
</section>

<!-- EBOOKS SECTION -->
<section class="section section-alt">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow" data-i18n="home.ebooksEyebrow">eBooks</span>
      <h2 data-i18n="home.ebooksTitle">Go Deeper With Practical eBooks</h2>
      <p class="lede" data-i18n="home.ebooksDescription">Practical, step-by-step agricultural eBooks — written from real research and farm experience.</p>
    </div>
    <div class="ebook-grid">
      {% for ebook in collections.ebooks %}
      <a class="ebook-card" href="{{ ebook.url }}">
        <img class="ebook-card-icon" src="{{ ebook.data.icon }}" alt="{{ ebook.data.title }} guide cover">
        <h3>{{ ebook.data.title }}</h3>
        <p class="tagline">{{ ebook.data.tagline }}</p>
        <div class="card-footer">
          <span class="price">{{ ebook.data.price | currency }}</span>
          <span class="cta" data-i18n="home.viewGuide">View Guide &rarr;</span>
        </div>
      </a>
      {% endfor %}
    </div>
    <div style="text-align:center;margin-top:28px;">
      <a class="btn btn-outline" href="/ebooks/" data-i18n="home.allEbooks">See All eBooks</a>
    </div>
  </div>
</section>

<!-- ABOUT STRIP -->
<section class="section">
  <div class="container" style="display:flex;gap:48px;align-items:center;flex-wrap:wrap;">
    <div style="flex:1;min-width:260px;">
      <span class="eyebrow" data-i18n="home.aboutEyebrow">About GoOrganicAfrica</span>
      <h2 data-i18n="home.aboutTitle">Built from the Farm, Not the Classroom</h2>
      <p style="color:var(--ink-soft);">
        <span data-i18n="home.aboutDescription">GoOrganicAfrica is built by Amoo Oluwatoyin Owolabi — farmer, agricultural researcher and organic bio-fertilizer producer. The platform combines practical farm experience and agricultural research to help African farmers plan with clearer numbers.</span>
      </p>
      <a class="btn btn-outline btn-sm" href="/about/" data-i18n="home.readMore">Read More</a>
    </div>
    <div style="flex:1;min-width:220px;">
      <div class="trust-strip" style="grid-template-columns:repeat(2,1fr);">
        <div class="trust-item">
          <span class="num">{{ collections.ebooks.length }}</span>
          <span class="label" data-i18n="home.ebooksEyebrow">eBooks</span>
        </div>
        <div class="trust-item">
          <span class="num">{{ site.calculator.countryCount }}</span>
          <span class="label" data-i18n="home.calculatorCountries">Calculator countries</span>
        </div>
        <div class="trust-item">
          <span class="num">100%</span>
          <span class="label" data-i18n="home.farmTested">Farm-tested</span>
        </div>
        <div class="trust-item">
          <span class="num">Free</span>
          <span class="label" data-i18n="home.calculatorTool">Calculator tool</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- BLOG -->
<section class="section section-alt">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow" data-i18n="home.blogEyebrow">From the Blog</span>
      <h2 data-i18n="home.blogTitle">Farming Insights & Market Analysis</h2>
      <p class="lede" data-i18n="home.blogDescription">Practical articles across {{ collections.blogCategories | length }} categories — written to help African farmers make better decisions.</p>
    </div>
    {% if collections.posts.length > 0 %}
    <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:24px;">
      {% for post in collections.posts | slice(0, 4) %}
      <a href="{{ post.url }}" style="text-decoration:none;">
        <div class="ebook-card" style="height:100%;">
          {% if post.data.featured_image %}<img src="{{ post.data.featured_image }}" alt="{{ post.data.title }}" style="width:100%;height:180px;object-fit:cover;border-radius:4px;">{% endif %}
          <span class="eyebrow" style="font-size:0.68rem;">{{ post.data.category }}</span>
          <h3 style="font-size:1.05rem;">{{ post.data.title }}</h3>
          <p class="tagline" style="font-size:0.88rem;">{{ post.data.description }}</p>
          <div class="card-footer"><span style="font-size:0.8rem;color:var(--ink-soft);" data-i18n="home.readArticle">Read article</span><span class="cta">&rarr;</span></div>
        </div>
      </a>
      {% endfor %}
    </div>
    <div style="text-align:center;margin-top:28px;"><a class="btn btn-outline btn-sm" href="/blog/" data-i18n="home.allArticles">Explore All Articles</a></div>
    {% else %}
    <div class="empty-state"><p data-i18n="home.articlesEmpty">Articles will appear here automatically when published from the admin panel.</p><a class="btn btn-outline btn-sm" href="/blog/" data-i18n="home.exploreBlog">Explore Blog</a></div>
    {% endif %}
  </div>
</section>

