---
layout: layouts/calc-base.njk
title: Free Farm Profit Calculator Africa — GoOrganicAfrica
description: Free farm profit calculator for Nigerian and African farmers. Calculate farming costs, revenue, profit, ROI and break-even point with country-specific reference data and local overrides.
permalink: "/farm-profit-calculator/"
---

<!-- SEO headings — visible to Google, readable on page -->
<div style="background:var(--green-deep);color:var(--white);padding:20px 20px 0;text-align:center;">
  <h1 style="font-family:var(--font-display);font-size:1.3rem;font-weight:800;margin:0 0 6px;color:var(--white);" data-i18n="calc.pageTitle">Free Farm Profit Calculator</h1>
  <h2 style="font-family:var(--font-body);font-size:0.88rem;font-weight:400;margin:0 0 16px;opacity:0.85;color:var(--white);" data-i18n="calc.pageSubtitle">Plan your farm and estimate your profit.</h2>
</div>

<div class="calc-app" id="calc-app">
  <div class="calc-topbar">
    <a class="calc-brand" href="/farm-profit-calculator/">
      <img src="/images/brand-mark.svg" alt="" width="24" height="24">
      <span data-i18n="calc.calculatorBrand">Farm Profit Calculator</span>
    </a>
    <div class="calc-toolbar">
      <label class="calc-select-label" for="calc-country-switcher" data-i18n="calc.country">Country</label>
      <select id="calc-country-switcher" class="calc-toolbar-select" data-i18n-aria-label="calc.country" aria-label="Calculator country"></select>
      <label class="calc-select-label" for="calc-language-switcher" data-i18n="common.language">Language</label>
      <select id="calc-language-switcher" class="calc-toolbar-select" data-i18n-aria-label="common.language" aria-label="Calculator language"></select>
      <button class="calc-install-btn" id="install-btn" data-i18n-title="common.installApp" data-i18n="common.installApp">&#8681; Install App</button>
    </div>
  </div>

  <div class="calc-shell" id="calc-root">
    <p style="color:var(--ink-soft);padding:40px 0;text-align:center;" data-i18n="common.loading">Loading calculator&hellip;</p>
  </div>
</div>

<!-- Data injected first, before any scripts -->
<script>
  window.__CALC_DATA__ = {
    commodities: {{ calculatorCommodities | dump | safe }},
    countries:   {{ calculator.countries | dump | safe }},
    regions:     {{ calculator.regions | dump | safe }},
    defaultCountry: "{{ defaultCountry or '' }}",
    defaultLanguage: "{{ defaultLanguage or 'en' }}"
  };
</script>

<!-- Scripts loaded in strict order, NO defer - each must finish before next starts -->
<script defer src="/js/calculator-engine.js?v=20260926"></script>
<script defer src="/js/calculator-advice.js?v=20260926"></script>
<script defer src="/js/calculator-app.js?v=20260926"></script>

<script>
(function () {
  function startCalc() {
    var root = document.getElementById("calc-root");
    if (!root) return;

    // Safety check - all three pieces must be ready
    if (!window.FarmCalcEngine) {
      root.innerHTML = '<p style="color:red;padding:20px;">Calculator engine failed to load. Please refresh the page.</p>';
      return;
    }
    if (!window.FarmProfitCalculator) {
      root.innerHTML = '<p style="color:red;padding:20px;">Calculator app failed to load. Please refresh the page.</p>';
      return;
    }
    if (!window.__CALC_DATA__) {
      root.innerHTML = '<p style="color:red;padding:20px;">Calculator data failed to load. Please refresh the page.</p>';
      return;
    }

    window.FarmProfitCalculator.init(root, window.__CALC_DATA__);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", startCalc);
  } else {
    startCalc();
  }

  // PWA install prompt
  var deferredPrompt;
  window.addEventListener("beforeinstallprompt", function (e) {
    e.preventDefault();
    deferredPrompt = e;
    var btn = document.getElementById("install-btn");
    if (btn) {
      btn.classList.add("visible");
      btn.onclick = function () {
        deferredPrompt.prompt();
        deferredPrompt.userChoice.then(function () {
          deferredPrompt = null;
          btn.classList.remove("visible");
        });
      };
    }
  });
})();
</script>
