---
layout: layouts/base.njk
title: Blog — Organic Farming Insights for Africa
description: Practical articles on hydroponic fodder farming, black soldier fly farming, cassava production, oyster mushroom farming and more — written for Nigerian and African farmers.
permalink: "/blog/"
---

<section class="section" style="padding-top: 48px;">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow" data-i18n="blog.eyebrow">The Blog</span>
      <h1 data-i18n="blog.title">GoOrganicAfrica Farming Blog</h1>
      <p class="lede" data-i18n="blog.description">Practical, research-backed articles to help African farmers make better decisions and grow more profitably.</p>
    </div>

    <h2 style="font-size:1.2rem;color:var(--green-deep);margin-bottom:16px;" data-i18n="blog.browseCategory">Browse by Category</h2>

    <div class="category-grid" style="margin-bottom: 40px;">
      {% for cat in collections.blogCategories %}
        {% if cat.data.active != false %}
        <div class="category-card">
          <h3 data-i18n="blog.categories.{{ "crop" if cat.data.slug == "crop-production" else "livestock" if cat.data.slug == "livestock-farming" else "organic" if cat.data.slug == "organic-farming" else "agribusiness" if cat.data.slug == "agribusiness" else "inputs" if cat.data.slug == "farm-inputs" else "markets" if cat.data.slug == "farming-data" else cat.data.slug }}">{{ cat.data.title }}</h3>
          <p>{{ cat.data.description }}</p>
        </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if collections.posts.length > 0 %}
    <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:24px;">
      {% for post in collections.posts %}
      {% set cardKey = "blog.cards." + (
        "bsf" if post.data.slug == "black-soldier-fly-farming-africa" else
        "fodder" if post.data.slug == "hydroponic-fodder-farming-africa" else
        "mushroom" if post.data.slug == "oyster-mushroom-farming-nigeria" else
        "cassava" if post.data.slug == "weed-free-cassava-farming-nigeria" else post.data.slug
      ) %}
      <a href="{{ post.url }}" class="content-variant" data-content-group="{{ post.data.translation_group or post.data.slug }}" data-content-language="{{ post.data.language or 'en' }}" style="text-decoration:none;">
        <div class="ebook-card" style="height:100%;">
          {% if post.data.featured_image %}
          <img src="{{ post.data.featured_image }}" alt="{{ post.data.title }}"
            style="width:100%;height:180px;object-fit:cover;border-radius:4px;">
          {% endif %}
          <span class="eyebrow" style="font-size:0.68rem;">{{ post.data.category }}</span>
          <h3 style="font-size:1.05rem;" data-i18n="{{ cardKey }}.title">{{ post.data.title }}</h3>
          <p class="tagline" style="font-size:0.88rem;" data-i18n="{{ cardKey }}.description">{{ post.data.description }}</p>
          <div class="card-footer">
            <span style="font-size:0.8rem;color:var(--ink-soft);" data-i18n="blog.readArticle">Read article</span>
            <span class="cta">&rarr;</span>
          </div>
        </div>
      </a>
      {% endfor %}
    </div>
    {% else %}
    <div class="empty-state">
      <p data-i18n="blog.empty">Articles are being written and will appear here soon.</p>
    </div>
    {% endif %}

    <div style="text-align:center;margin-top:40px;">
      <a class="btn btn-primary" href="/farm-profit-calculator/" data-i18n="blog.tryCalculator">Try the Free Farm Profit Calculator</a>
    </div>
  </div>
</section>
