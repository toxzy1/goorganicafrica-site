---
layout: layouts/base.njk
title: Agricultural Finance & Farm Funding | GoOrganicAfrica
description: Agricultural loans, insurance, input finance, equipment finance and leasing resources for African farmers and agribusinesses.
permalink: "/agricultural-finance/"
---
{% set listings = directoryListings.listings | default([]) %}
{% set finance = listings | selectattr("type","equalto","finance") | selectattr("active","equalto",true) | list %}
<section class="section" style="padding-top:48px;">
  <div class="container" style="max-width:1050px;">
    <span class="eyebrow">Funding Directory</span>
    <h1>Agricultural Finance</h1>
    <p class="lede">Explore verified agricultural finance programmes and funding routes. Always confirm current eligibility and application arrangements with the official source.</p>
    <div data-directory-filter style="margin-top:28px;padding:20px;border:1px solid var(--line);border-radius:12px;">
      <label for="finance-search"><strong>Search finance resources</strong></label>
      <input id="finance-search" data-filter-search type="search" placeholder="Search by programme, country, finance type or keyword" style="width:100%;margin-top:8px;padding:12px;border:1px solid var(--line);border-radius:8px;">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px;margin-top:12px;">
        <select data-filter-country aria-label="Filter by country" style="padding:11px;border:1px solid var(--line);border-radius:8px;"><option value="">All countries</option>{% for item in finance %}<option value="{{ item.country }}">{{ item.country }}</option>{% endfor %}</select>
        <select data-filter-category aria-label="Filter by finance category" style="padding:11px;border:1px solid var(--line);border-radius:8px;"><option value="">All finance categories</option><option value="Agricultural Finance">Agricultural Finance</option><option value="Input Finance">Input Finance</option><option value="Climate & Agricultural Finance">Climate & Agricultural Finance</option><option value="Agricultural Water & Climate Finance">Agricultural Water & Climate Finance</option></select>
        <select data-filter-status aria-label="Filter by verification status" style="padding:11px;border:1px solid var(--line);border-radius:8px;"><option value="">All published statuses</option><option value="verified">Verified</option><option value="needs_review">Needs review</option></select>
      </div>
      <p style="margin:12px 0 0;"><strong data-filter-count>{{ finance | length }} listings</strong></p>
    </div>
    <div style="display:grid;gap:18px;margin-top:22px;">
      {% for item in finance %}{% if item.verification_status != "closed" and item.verification_status != "expired" %}
      <article data-directory-item data-country="{{ item.country }}" data-category="{{ item.category }}" data-status="{{ item.verification_status }}" data-search="{{ item.title }} {{ item.country }} {{ item.category }} {{ item.finance_type }} {{ item.description }} {{ item.eligibility }}" style="padding:22px;border:1px solid var(--line);border-radius:12px;">
        <h2 style="margin-top:0;">{{ item.title }}</h2>
        <p><strong>{{ item.country }}</strong>{% if item.region %} · {{ item.region }}{% endif %}</p>
        {% if item.category %}<p><strong>Category:</strong> {{ item.category }}</p>{% endif %}
        {% if item.finance_type %}<p><strong>Finance type:</strong> {{ item.finance_type | replace("_"," ") }}</p>{% endif %}
        {% if item.finance_amount %}<p><strong>Amount / range:</strong> {{ item.finance_amount }}</p>{% endif %}
        {% if item.pricing %}<p><strong>Interest / pricing:</strong> {{ item.pricing }}</p>{% endif %}
        <p>{{ item.description }}</p>
        {% if item.eligibility %}<p><strong>Eligibility:</strong> {{ item.eligibility }}</p>{% endif %}
        <p style="font-size:.9rem;"><strong>Status:</strong> {{ item.verification_status | replace("_"," ") }}{% if item.last_verified %} · <strong>Last verified:</strong> {{ item.last_verified | replace("T"," ") | replace("Z","") }}{% endif %}</p>
        {% if item.application_url %}<a class="btn btn-primary" href="{{ item.application_url }}" target="_blank" rel="noopener noreferrer">Application / Official Page</a>{% elif item.official_url %}<a class="btn btn-primary" href="{{ item.official_url }}" target="_blank" rel="noopener noreferrer">Official Source</a>{% elif item.url %}<a class="btn btn-primary" href="{{ item.url }}" target="_blank" rel="noopener noreferrer">Official Website</a>{% endif %}
      </article>{% endif %}{% endfor %}
    </div>
    <div data-filter-empty hidden style="margin-top:22px;padding:24px;border:1px solid var(--line);border-radius:12px;"><h2>No matching finance resources</h2><p>Try another country, category or search term.</p></div>
    <p style="margin-top:28px;"><a href="/agriculture-resources/">← Back to Agricultural Resources</a></p>
  </div>
</section>
<script src="/js/directory-filter.js" defer></script>