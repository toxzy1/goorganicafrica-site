---
layout: layouts/base.njk
title: Farm Machinery & Equipment Directory | GoOrganicAfrica
description: Find tractors, planters, harvesters, irrigation, processing, greenhouse and other agricultural machinery and equipment resources.
permalink: "/farm-machinery/"
---
{% set listings = directoryListings.listings | default([]) %}
{% set equipment = listings | selectattr("type","equalto","equipment") | selectattr("active","equalto",true) | list %}
<section class="section" style="padding-top:48px;"><div class="container" style="max-width:1050px;">
<span class="eyebrow">Machinery Directory</span><h1>Farm Machinery & Equipment</h1>
<p class="lede">A structured directory for tractors, implements, irrigation, processing, greenhouse equipment, mechanisation services and other agricultural equipment resources.</p>
<div data-directory-filter style="margin-top:28px;padding:20px;border:1px solid var(--line);border-radius:12px;">
<label for="machinery-search"><strong>Search machinery & equipment</strong></label>
<input id="machinery-search" data-filter-search type="search" placeholder="Search by equipment, country, category or keyword" style="width:100%;margin-top:8px;padding:12px;border:1px solid var(--line);border-radius:8px;">
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px;margin-top:12px;">
<select data-filter-country aria-label="Filter by country" style="padding:11px;border:1px solid var(--line);border-radius:8px;"><option value="">All countries</option>{% for item in equipment %}<option value="{{ item.country }}">{{ item.country }}</option>{% endfor %}</select>
<select data-filter-category aria-label="Filter by equipment category" style="padding:11px;border:1px solid var(--line);border-radius:8px;"><option value="">All equipment categories</option><option value="tractor">Tractor</option><option value="planter">Planter</option><option value="harvester">Harvester</option><option value="irrigation">Irrigation</option><option value="processing">Processing</option><option value="greenhouse">Greenhouse</option><option value="solar_pumping">Solar pumping</option><option value="implements">Implements</option><option value="other">Other</option></select>
<select data-filter-status aria-label="Filter by verification status" style="padding:11px;border:1px solid var(--line);border-radius:8px;"><option value="">All published statuses</option><option value="verified">Verified</option><option value="needs_review">Needs review</option></select>
</div><p style="margin:12px 0 0;"><strong data-filter-count>{{ equipment | length }} listings</strong></p></div>
<div style="display:grid;gap:18px;margin-top:22px;">
{% for item in equipment %}{% if item.verification_status != "closed" and item.verification_status != "expired" %}
<article data-directory-item data-country="{{ item.country }}" data-category="{{ item.equipment_category }}" data-status="{{ item.verification_status }}" data-search="{{ item.title }} {{ item.country }} {{ item.category }} {{ item.equipment_category }} {{ item.description }} {{ item.lease_terms }}" style="padding:22px;border:1px solid var(--line);border-radius:12px;">
<h2 style="margin-top:0;">{{ item.title }}</h2><p><strong>{{ item.country }}</strong>{% if item.region %} · {{ item.region }}{% endif %}</p>
{% if item.category %}<p><strong>Category:</strong> {{ item.category }}</p>{% endif %}{% if item.equipment_category %}<p><strong>Equipment type:</strong> {{ item.equipment_category | replace("_"," ") }}</p>{% endif %}
<p>{{ item.description }}</p>{% if item.lease_terms %}<p><strong>Lease / rental:</strong> {{ item.lease_terms }}</p>{% endif %}
<p style="font-size:.9rem;"><strong>Status:</strong> {{ item.verification_status | replace("_"," ") }}{% if item.last_verified %} · <strong>Last verified:</strong> {{ item.last_verified | replace("T"," ") | replace("Z","") }}{% endif %}</p>
{% if item.application_url %}<a class="btn btn-primary" href="{{ item.application_url }}" target="_blank" rel="noopener noreferrer">Provider / Application</a>{% elif item.official_url %}<a class="btn btn-primary" href="{{ item.official_url }}" target="_blank" rel="noopener noreferrer">Official Source</a>{% elif item.url %}<a class="btn btn-primary" href="{{ item.url }}" target="_blank" rel="noopener noreferrer">Provider Website</a>{% endif %}
</article>{% endif %}{% endfor %}</div>
<div data-filter-empty hidden style="margin-top:22px;padding:24px;border:1px solid var(--line);border-radius:12px;"><h2>No matching machinery resources</h2><p>Try another country, equipment category or search term.</p></div>
<p style="margin-top:28px;"><a href="/agriculture-resources/">← Back to Agricultural Resources</a></p></div></section>
<script src="/js/directory-filter.js" defer></script>