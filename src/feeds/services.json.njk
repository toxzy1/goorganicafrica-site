{% set records = [] %}
{% for r in agriculturalServices.records %}
  {% if r.is_current and r.status not in ["draft","review","needs_review"] %}
    {% set obj = {"country_code": r.country_code, "country": r.country, "title": r.title, "summary": r.summary, "category": r.category, "type": r.type, "provider": r.provider, "url": r.url, "verified": r.verified, "source_tier": r.source_tier} %}
    {% set records = (records.push(obj), records) %}
  {% endif %}
{% endfor %}
