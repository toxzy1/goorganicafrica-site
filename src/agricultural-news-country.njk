---
layout: layouts/base.njk
pagination:
  data: agriculturalNews.countries
  size: 1
  alias: country
permalink: "/agricultural-news/{{ country.slug }}/"
language: en
pageLanguage: en
---
<div id="goa-language-targets"
 data-url-en="/agricultural-news/{{ country.slug }}/"
 data-url-fr="/fr/agricultural-news/{{ country.slug }}/"
 data-url-ar="/ar/agricultural-news/{{ country.slug }}/"
 data-url-pt="/pt/agricultural-news/{{ country.slug }}/"
 data-url-sw="/sw/agricultural-news/{{ country.slug }}/"></div><section class="section" style="padding-top:48px;">
<div class="container">
<p><a href="/agricultural-news/">← All Agricultural News</a></p>
<h1>{{ country.flag }} Agricultural News — {{ country.name }}</h1>
<p class="lede">Current, verified agricultural developments for this country.</p>
{% if country.articles and country.articles.length %}
{% for article in country.articles %}
{% set translated = article.translations[pageLanguage or language] if article.translations else null %}
<article class="card" style="margin:16px 0;">
<h2>{{ translated.title or article.title }}</h2><p>{{ translated.summary or article.summary }}</p>
<p><small>Source: {{ article.source }} · Verified: {{ article.verified }}</small></p>
<a href="{{ article.url }}" target="_blank" rel="noopener noreferrer">Read original source →</a>
</article>
{% endfor %}
{% else %}
<div class="card"><h2>News is being verified</h2><p>No current verified stories have been published for this country yet.</p><p>We will add stories only after checking an official or authoritative source.</p></div>
{% endif %}
</div></section>