---
layout: layouts/base.njk
---
{% set ogImage = featured_image %}
{% set jsonLd %}
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "{{ title }}",
  "description": "{{ meta_description or description }}",
  "image": "{{ site.url }}{{ featured_image }}",
  "author": {
    "@type": "Person",
    "name": "{{ site.author }}",
    "url": "{{ site.url }}/about/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}"
  },
  "datePublished": "{{ date }}",
  "dateModified": "{{ date }}",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ site.url }}{{ page.url }}"
  },
  "keywords": "{{ keywords | join(', ') }}",
  "articleSection": "{{ category }}"
}
{% endset %}

<article class="section" style="padding-top: 48px; padding-bottom: 56px;">
  <div class="container" style="max-width: 760px;">

    <!-- Breadcrumb for SEO -->
    <nav aria-label="Breadcrumb" style="font-size:0.85rem;color:var(--ink-soft);margin-bottom:16px;">
      <a href="/" style="color:var(--soil);text-decoration:none;" data-i18n="common.home">Home</a> /
      <a href="/blog/" style="color:var(--soil);text-decoration:none;" data-i18n="common.blog">Blog</a> /
      <span>{{ category }}</span>
    </nav>

    <span class="eyebrow">{{ category }}</span>
    <h1>{{ title }}</h1>

    {% if translation_group %}
    <div class="translation-links" aria-label="Available article languages">
      <strong data-i18n="blog.language">Language:</strong>
      {% set hasTranslation = false %}
      {% for p in collections.posts %}
        {% if p.data.translation_group == translation_group %}
          {% set hasTranslation = true %}<a href="{{ p.url }}" hreflang="{{ p.data.language or 'en' }}">{{ p.data.language or 'en' }}</a>
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}

    <!-- Article meta -->
    <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:center;margin:12px 0 24px;font-size:0.82rem;color:var(--ink-soft);">
      <span>&#128100; {{ site.author }}</span>
      <span>&#128197; {{ date | readableDate }}</span>
      <span>&#128203; {{ category }}</span>
    </div>

    {% if featured_image %}
    <img src="{{ featured_image }}" alt="{{ title }}"
      style="width:100%;border-radius:8px;margin-bottom:32px;box-shadow:0 2px 12px rgba(0,0,0,0.1);"
      loading="eager" fetchpriority="high">
    {% endif %}

    <!-- Article body -->
    <div class="post-body" style="line-height:1.85;color:var(--ink);">
      {{ content | safe }}
    </div>

    <!-- Tags / related categories -->
    <div style="margin-top:32px;padding-top:20px;border-top:1px solid var(--line);">
      <strong style="font-size:0.85rem;" data-i18n="blog.filedUnder">Filed under:</strong>
      <a href="/blog/" style="background:var(--sage-light);color:var(--green-deep);padding:4px 12px;border-radius:20px;font-size:0.82rem;text-decoration:none;margin-left:8px;font-weight:600;">{{ category }}</a>
    </div>

    {% if show_ebook_cta and related_ebook_slug %}
      {% set relatedEbook = collections.ebooks | findByDataSlug(related_ebook_slug) %}
      {% if relatedEbook %}
      <div style="margin-top:32px;padding:24px;border:1px solid var(--line);border-radius:12px;background:var(--sage-light);">
        <span class="eyebrow" data-i18n="blog.recommendedGuide">Recommended Guide</span>
        <h2 style="margin:8px 0;">{{ relatedEbook.data.title }}</h2>
        <p style="margin:0 0 16px;color:var(--ink-soft);">{{ relatedEbook.data.tagline }}</p>
        <a class="btn btn-primary btn-sm" href="{{ relatedEbook.data.selar_link }}">Get the Guide — {{ relatedEbook.data.price | currency }}</a>
      </div>
      {% endif %}
    {% endif %}

    <!-- Internal navigation -->
    <div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:24px;padding-top:16px;border-top:1px solid var(--line);">
      <a class="btn btn-outline btn-sm" href="/blog/"><span data-i18n="blog.allArticles">&larr; All Articles</span></a>
      <a class="btn btn-primary btn-sm" href="/farm-profit-calculator/" data-i18n="blog.tryCalculator">Try Farm Profit Calculator</a>
      <a class="btn btn-outline btn-sm" href="/ebooks/" data-i18n="blog.browseGuides">Browse Guides</a>
    </div>

  </div>
</article>

<!-- Related ebooks -->
<section class="section section-alt" style="padding:48px 0;">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow" data-i18n="blog.relatedGuides">Related Guides</span>
      <h2 data-i18n="blog.goDeeper">Go Deeper With Our Farming Guides</h2>
      <p class="lede" data-i18n="blog.relatedDescription">Step-by-step organic farming guides written from real research and farm experience across Nigeria and Africa.</p>
    </div>
    <div class="ebook-grid">
      {% for ebook in collections.ebooks %}
      <a class="ebook-card content-variant" href="{{ ebook.url }}" data-content-group="{{ ebook.data.translation_group or ebook.data.slug }}" data-content-language="{{ ebook.data.language or 'en' }}">
        <img class="ebook-card-icon" src="{{ ebook.data.icon }}"
          alt="{{ ebook.data.title }} farming guide cover">
        <h3>{{ ebook.data.title }}</h3>
        <p class="tagline">{{ ebook.data.tagline }}</p>
        <div class="card-footer">
          <span class="price">{{ ebook.data.price | currency }}</span>
          <span class="cta" data-i18n="ebooks.viewGuide">View Guide &rarr;</span>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
