<div class="site-language" aria-label="Language selector" data-i18n-aria-label="common.language">
  <label for="site-language-select" data-i18n="common.language">Language</label>
  <select id="site-language-select">
    {% for lang in siteLanguages.languages %}{% if lang.enabled != false %}<option value="{{ lang.code }}">{{ lang.native }}</option>{% endif %}{% endfor %}
  </select>
</div>
