<header class="site-header">
  {% set isCalculatorPage = (page.url or "").endsWith("/farm-profit-calculator/") %}
  {% if not isCalculatorPage %}
  <div class="top-language-bar">{% include "partials/language-selectors/static.njk" %}</div>
  {% endif %}
  <nav class="nav">
    <a class="brand" href="{% if (language or 'en') == 'en' %}/{% else %}/{{ language or 'en' }}/{% endif %}" data-localized-section="home">
      <img class="brand-mark" src="/images/brand-mark.svg" alt="" width="28" height="28">
      {{ site.name }}
    </a>
    <button class="nav-toggle" aria-label="Toggle menu" data-i18n-aria-label="common.toggleMenu" aria-expanded="false">
      <span></span>
    </button>
    <ul class="nav-links">
      <li><a href="{% if (language or 'en') == 'en' %}/{% else %}/{{ language or 'en' }}/{% endif %}" data-localized-section="home" data-i18n="common.home">Home</a></li>
      <li><a href="/farm-profit-calculator/" data-localized-section="calculator" data-i18n="common.calculator">Calculator</a></li>
      <li><a href="{% if (language or 'en') == 'en' %}/ebooks/{% else %}/{{ language or 'en' }}/ebooks/{% endif %}" data-localized-section="ebooks" data-i18n="common.ebooks">eBooks</a></li>
      <li><a href="{% if (language or 'en') == 'en' %}/organic-farming/{% else %}/{{ language or 'en' }}/organic-farming/{% endif %}" data-localized-section="organic-farming" data-i18n="common.organicFarming">Organic Farming</a></li>
      <li><a href="{% if (language or 'en') == 'en' %}/blog/{% else %}/{{ language or 'en' }}/blog/{% endif %}" data-localized-section="blog" data-i18n="common.blog">Blog</a></li>

      <li><a href="/agriculture-resources/" data-localized-section="resources" data-i18n="common.resources">Resources</a></li>
      <li><a href="/opportunities/" data-localized-section="opportunities">Opportunities</a></li>
      <li><a href="/markets/" data-localized-section="markets">Markets</a></li>
      <li><a href="/agricultural-services/" data-localized-section="agricultural-services">Services</a></li>
      <li><a href="/agricultural-news/" data-localized-section="agricultural-news" data-i18n="common.agriculturalNews">Agricultural News</a></li>
      <li><a href="/search/" data-localized-section="search">Search</a></li>
<li><a href="/agricultural-intelligence/" data-localized-section="agricultural-intelligence">Intelligence Hub</a></li>
      <li><a href="/about/" data-localized-section="about" data-i18n="common.about">About</a></li>
      <li><a href="/contact/" data-localized-section="contact" data-i18n="common.contact">Contact</a></li>
      {% if isCalculatorPage %}
      <li class="site-language">
        <label for="site-language-select" class="visually-hidden" data-i18n="common.language">Language</label>
        <select id="site-language-select" class="site-language-select" aria-label="Language" data-i18n-aria-label="common.language">
          {% for lang in siteLanguages.languages %}
          {% if lang.enabled != false %}<option value="{{ lang.code }}"{% if (language or "en") == lang.code %} selected{% endif %}>{{ lang.native }}</option>{% endif %}
          {% endfor %}
        </select>
      </li>
      {% endif %}
    </ul>
  </nav>
</header>
