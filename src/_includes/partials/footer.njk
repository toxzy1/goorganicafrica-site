<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <h4>{{ site.name }}</h4>
        <p data-i18n="common.footerDescription">{{ site.tagline }}. Written from real farm experience and continuous agricultural research by {{ site.author }}.</p>
      </div>
      <div>
        <h4 data-i18n="common.quickLinks">Quick Links</h4>
        <ul class="footer-links">
          <li><a href="/farm-profit-calculator/" data-localized-section="calculator" data-i18n="common.calculator">Farm Profit Calculator</a></li>
          <li><a href="{% if (language or 'en') == 'en' %}/ebooks/{% else %}/{{ language or 'en' }}/ebooks/{% endif %}" data-localized-section="ebooks" data-i18n="common.ebooks">Farming Guides</a></li>
          <li><a href="{% if (language or 'en') == 'en' %}/organic-farming/{% else %}/{{ language or 'en' }}/organic-farming/{% endif %}" data-localized-section="organic-farming" data-i18n="common.organicFarming">Organic Farming</a></li>
          <li><a href="{% if (language or 'en') == 'en' %}/blog/{% else %}/{{ language or 'en' }}/blog/{% endif %}" data-localized-section="blog" data-i18n="common.blog">Blog</a></li>
          <li><a href="{% if (language or 'en') == 'en' %}/agriculture-resources/{% else %}/{{ language or 'en' }}/agriculture-resources/{% endif %}" data-localized-section="resources" data-i18n="common.resources">Agricultural Resources</a></li>
          <li><a href="{% if (language or 'en') == 'en' %}/opportunities/{% else %}/{{ language or 'en' }}/opportunities/{% endif %}" data-localized-section="opportunities" data-i18n="common.opportunities">Opportunities</a></li>
          <li><a href="{% if (language or 'en') == 'en' %}/markets/{% else %}/{{ language or 'en' }}/markets/{% endif %}" data-localized-section="markets" data-i18n="common.markets">Markets</a></li>
          <li><a href="{% if (language or 'en') == 'en' %}/agricultural-news/{% else %}/{{ language or 'en' }}/agricultural-news/{% endif %}" data-localized-section="agricultural-news" data-i18n="common.agriculturalNews">Agricultural News</a></li>

          <li><a href="{% if (language or 'en') == 'en' %}/my-agriculture/{% else %}/{{ language or 'en' }}/my-agriculture/{% endif %}" data-localized-section="my-agriculture" data-i18n="common.myAgriculture">My Agriculture Watchlist</a></li>
          <li><a href="{% if (language or 'en') == 'en' %}/about/{% else %}/{{ language or 'en' }}/about/{% endif %}" data-localized-section="about" data-i18n="common.about">About</a></li>
          <li><a href="{% if (language or 'en') == 'en' %}/privacy-policy/{% else %}/{{ language or 'en' }}/privacy-policy/{% endif %}" data-i18n="common.privacy">Privacy Policy</a></li>
        </ul>
      </div>
      <div>
        <h4 data-i18n="common.getInTouch">Get in touch</h4>
        <ul class="footer-links">
          <li><a href="{{ site.whatsapp }}">WhatsApp: {{ site.phone }}</a></li>
          <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          <li><a href="{% if (language or 'en') == 'en' %}/contact/{% else %}/{{ language or 'en' }}/contact/{% endif %}" data-localized-section="contact" data-i18n="common.contactPage">Contact page</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span data-i18n="common.copyright" data-i18n-vars='{"year":"{{ site.currentYear }}"}'>&copy; {{ site.currentYear }} {{ site.name }}. All rights reserved.</span>
      <span>
        <a href="{% if (language or 'en') == 'en' %}/privacy-policy/{% else %}/{{ language or 'en' }}/privacy-policy/{% endif %}" style="color:#a9bfa4;text-decoration:none;" data-i18n="common.privacy">Privacy Policy</a>
        &nbsp;&middot;&nbsp;
        <span data-i18n="common.organicGuides">Organic farming guides for Nigeria, Africa &amp; beyond.</span>
      </span>
    </div>
  </div>
  <a href="{% if (language or 'en') == 'en' %}/data-updates/{% else %}/{{ language or 'en' }}/data-updates/{% endif %}" data-i18n="common.dataSources">Data Sources &amp; Updates</a>
</footer>
