<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <h4>{{ site.name }}</h4>
        <p data-i18n="common.footerDescription">{{ site.tagline }}. Written from real farm experience and continuous agricultural research by {{ site.author }}.</p>
      </div>
      <div>
        <h4 data-i18n="common.quickLinks">Quick Links</h4>
        <ul class="footer-links">
          <li><a href="/farm-profit-calculator/" data-i18n="common.calculator">Farm Profit Calculator</a></li>
          <li><a href="/ebooks/" data-i18n="common.ebooks">Farming Guides</a></li>
          <li><a href="/blog/" data-i18n="common.blog">Blog</a></li>
          <li><a href="/about/" data-i18n="common.about">About</a></li>
          <li><a href="/privacy-policy/" data-i18n="common.privacy">Privacy Policy</a></li>
        </ul>
      </div>
      <div>
        <h4 data-i18n="common.getInTouch">Get in touch</h4>
        <ul class="footer-links">
          <li><a href="{{ site.whatsapp }}">WhatsApp: {{ site.phone }}</a></li>
          <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          <li><a href="/contact/" data-i18n="common.contactPage">Contact page</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span data-i18n="common.copyright">&copy; {{ site.currentYear }} {{ site.name }}. All rights reserved.</span>
      <span>
        <a href="/privacy-policy/" style="color:#a9bfa4;text-decoration:none;" data-i18n="common.privacy">Privacy Policy</a>
        &nbsp;&middot;&nbsp;
        <span data-i18n="common.organicGuides">Organic farming guides for Nigeria, Africa &amp; beyond.</span>
      </span>
    </div>
  </div>
  <a href="/data-updates/" data-i18n="common.dataSources">Data Sources &amp; Updates</a>
</footer>
