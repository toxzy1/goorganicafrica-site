{% set L = labels[lang] or labels.en %}
<section class="section" style="padding-top:48px;">
<div class="container" style="max-width:1100px;" {% if lang=="ar" %}dir="rtl"{% endif %}>
<span class="eyebrow">{{L.eyebrow}}</span><h1>{{L.title}}</h1><p class="lede">{{L.intro}}</p>
<div style="display:grid;grid-template-columns:2fr 1fr 1fr;gap:12px;margin:28px 0 18px;">
<input id="resourceSearch" type="search" placeholder="{{L.search}}" aria-label="{{L.search}}" style="width:100%;padding:14px;border:1px solid var(--line);border-radius:10px;">
<select id="resourceCountry" aria-label="{{L.country}}" style="padding:14px;border:1px solid var(--line);border-radius:10px;"><option value="">{{L.country}}</option>{% for country in agriculturalResourcesAll.countries | sort(false,false,"name") %}<option value="{{country.code}}" data-country-code="{{country.code}}" data-country-flag="{{country.flag}}" data-country-name="{{country.name}}">{{country.flag}} {{country.name}}</option>{% endfor %}</select>
<select id="resourceCategory" aria-label="{{L.category}}" style="padding:14px;border:1px solid var(--line);border-radius:10px;"><option value="">{{L.category}}</option>{% for category in agriculturalResourcesAll.categories %}<option value="{{category}}">{{L[category] or category | replace("-"," ") | title}}</option>{% endfor %}</select>
</div>
<div style="display:flex;justify-content:space-between;gap:12px;align-items:center;margin:10px 0 18px;font-size:.92rem;"><strong id="resourceCount">{{agriculturalResourcesAll.total}} {{L.results}}</strong><span>{{agriculturalResourcesAll.countries|length}} {{L.coverage}}</span></div>
<p id="resourceEmpty" role="status" hidden style="padding:16px;border:1px dashed var(--line);border-radius:8px;">{{L.noResults}}</p>
<div id="resourceDirectory" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:14px;">
{% for country in agriculturalResourcesAll.countries | sort(false,false,"name") %}
<details class="resource-country" data-country="{{country.code}}" style="padding:14px;border:1px solid var(--line);border-radius:10px;"><summary style="cursor:pointer;font-weight:700;">{{country.flag}} <span class="resource-country-name" data-resource-country-name="{{country.code}}">{{country.name}}</span> <span style="opacity:.65;font-weight:400;">({{country.total}})</span></summary><div style="margin-top:12px;">
{% for category in agriculturalResourcesAll.categories %}{% if country.records[category] and country.records[category]|length %}
<h3 class="resource-category-heading" data-category="{{category}}" style="font-size:1rem;margin:16px 0 8px;">{{L[category] or category|replace("-"," ")|title}}</h3>
{% for record in country.records[category] %}{% set localizedRecord = record.localized[lang] if record.localized and record.localized[lang] else {} %}<article class="resource-card" data-resource-country-code="{{country.code}}" data-resource-country-name="{{country.name}}" data-category="{{category}}" data-search="{{(record.title ~ ' ' ~ record.description ~ ' ' ~ record.source ~ ' ' ~ (record.type or '') ~ ' ' ~ (record.tags or '') ~ ' ' ~ (record.access or '') ~ ' ' ~ (record.eligibility or '') ~ ' ' ~ (record.beneficiary or '') ~ ' ' ~ (record.deadline or '') ~ ' ' ~ (record.amount or '') ~ ' ' ~ (record.contact or '') ~ ' ' ~ (record.application_url or '') ~ ' ' ~ (localizedRecord.title or '') ~ ' ' ~ (localizedRecord.description or ''))|lower}}" style="padding:13px;margin:8px 0;border:1px solid var(--line);border-radius:8px;">{% if lang!="en" and record.localized and record.localized[lang] and record.localized[lang].title and record.localized[lang].description and (not record.translation_status or record.translation_status == "translated") %}
<strong>{{record.localized[lang].title}}</strong><p style="margin:6px 0;">{{record.localized[lang].description}}</p>
{% else %}
{% if lang!="en" %}<p class="translation-pending-note" data-translation-status="pending"><small>{{L.translationPending}}</small></p>{% else %}
<strong>{{record.title}}</strong><p style="margin:6px 0;">{{record.description}}</p>
{% endif %}
{% endif %}
{% if record.type %}<p class="resource-detail" data-resource-field="type" style="margin:5px 0;font-size:.9rem;"><strong>{{L.type}}:</strong> {% if lang=="en" %}{{record.type}}{% elif localizedRecord.type %}{{localizedRecord.type}}{% else %}<small class="translation-field-pending">{{L.translationPending}}</small>{% endif %}</p>{% endif %}
{% if record.amount %}<p class="resource-detail" data-resource-field="amount" style="margin:5px 0;font-size:.9rem;"><strong>{{L.amount}}:</strong> {{localizedRecord.amount or record.amount}}{% if lang!="en" and not localizedRecord.amount %} <small class="translation-field-pending">({{L.translationPending}})</small>{% endif %}</p>{% endif %}
{% if record.eligibility %}<p class="resource-detail" data-resource-field="eligibility" style="margin:5px 0;font-size:.9rem;"><strong>{{L.eligibility}}:</strong> {% if lang=="en" %}{{record.eligibility}}{% elif localizedRecord.eligibility %}{{localizedRecord.eligibility}}{% else %}<small class="translation-field-pending">{{L.translationPending}}</small>{% endif %}</p>{% endif %}
{% if record.beneficiary %}<p class="resource-detail" data-resource-field="beneficiary" style="margin:5px 0;font-size:.9rem;"><strong>{{L.beneficiary}}:</strong> {% if lang=="en" %}{{record.beneficiary}}{% elif localizedRecord.beneficiary %}{{localizedRecord.beneficiary}}{% else %}<small class="translation-field-pending">{{L.translationPending}}</small>{% endif %}</p>{% endif %}
{% if record.access %}<p class="resource-detail" data-resource-field="access" style="margin:5px 0;font-size:.9rem;"><strong>{{L.access}}:</strong> {% if lang=="en" %}{{record.access}}{% elif localizedRecord.access %}{{localizedRecord.access}}{% else %}<small class="translation-field-pending">{{L.translationPending}}</small>{% endif %}</p>{% endif %}
{% if record.deadline %}<p class="resource-detail" data-resource-field="deadline" style="margin:5px 0;font-size:.9rem;"><strong>{{L.deadline}}:</strong> {% if lang=="en" %}{{record.deadline}}{% elif localizedRecord.deadline %}{{localizedRecord.deadline}}{% else %}<small class="translation-field-pending">{{L.translationPending}}</small>{% endif %}</p>{% endif %}
{% if record.contact %}<p class="resource-detail" data-resource-field="contact" style="margin:5px 0;font-size:.9rem;"><strong>{{L.contact}}:</strong> {% if lang=="en" %}{{record.contact}}{% elif localizedRecord.contact %}{{localizedRecord.contact}}{% else %}<small class="translation-field-pending">{{L.translationPending}}</small>{% endif %}</p>{% endif %}
{% if record.lifecycle == "expired" or record.status == "expired" %}<p class="resource-detail" data-resource-field="status" style="margin:5px 0;font-size:.9rem;"><strong>{{L.status}}:</strong> {{L.expired}}</p>{% elif record.lifecycle == "closed" or record.status == "closed" %}<p class="resource-detail" data-resource-field="status" style="margin:5px 0;font-size:.9rem;"><strong>{{L.status}}:</strong> {{L.closed}}</p>{% elif record.lifecycle == "historical" or record.status == "historical" %}<p class="resource-detail" data-resource-field="status" style="margin:5px 0;font-size:.9rem;"><strong>{{L.status}}:</strong> {{L.historical}}</p>{% endif %}
{% if record.application_url and record.application_url != record.url %}<p class="resource-detail" data-resource-field="application" style="margin:5px 0;font-size:.9rem;"><a data-resource-application-link="true" href="{{record.application_url}}" target="_blank" rel="noopener noreferrer">{{L.application}}</a></p>{% endif %}
<div style="font-size:.82rem;opacity:.78;">{{L.source}}: {{record.source}} · {{L.verified}}: {{record.verified}}{% if record.status == "official" %} · <span>{{L.official}}</span>{% endif %}{% if record.shared_coverage and record.shared_coverage|length > 1 %} · <span>{{L.shared}}</span>{% endif %}</div><p class="resource-official-url" style="display:block;margin:12px 0 10px;overflow-wrap:anywhere;word-break:break-word;font-size:.85rem;line-height:1.6;"><strong>{{L.source}} URL:</strong><br><a href="{{record.url}}" target="_blank" rel="noopener noreferrer" style="display:inline-block;max-width:100%;overflow-wrap:anywhere;word-break:break-word;text-decoration:underline;line-height:1.6;">{{record.url}}</a></p><p style="display:block;margin:10px 0 2px;"><a href="{{record.url}}" target="_blank" rel="noopener noreferrer" style="display:inline-block;padding:8px 0;text-decoration:underline;">{{L.open}}</a></p></article>{% endfor %}{% endif %}{% endfor %}
</div></details>{% endfor %}
</div>
<section id="regionalAgriculturalIntelligence" style="margin-top:32px;padding:20px;border:1px solid var(--line);border-radius:12px;"><h2>{{L.regionalTitle}}</h2><p>{{L.regionalIntro}}</p>{% for region in agriculturalRegionalIntelligence.regions %}{% set localizedRegion = region.localized[lang] if region.localized and region.localized[lang] else {} %}<article class="regional-resource-card" data-region-code="{{region.code}}" style="padding:15px;margin-top:12px;border:1px solid var(--line);border-radius:10px;"><strong>{{localizedRegion.title or region.title}}</strong><p>{{localizedRegion.description or region.description}}</p><div style="font-size:.82rem;opacity:.78;"><span class="regional-country-list" data-regional-countries="{{region.countries|join(',')}}">{{region.countries|join(", ")}}</span> · {{L.verified}}: {{region.verified}}</div><a href="{{region.url}}" target="_blank" rel="noopener noreferrer">{{L.open}}</a></article>{% endfor %}</section>
<div style="margin-top:32px;padding:20px;border:1px solid var(--line);border-radius:12px;"><h2>{{L.current}}</h2><p>{{L.currentText}}</p></div>
</div></section>
<script>
(function(){
  const s=document.getElementById("resourceSearch"),c=document.getElementById("resourceCountry"),k=document.getElementById("resourceCategory"),n=document.getElementById("resourceCount"),empty=document.getElementById("resourceEmpty"),g=[...document.querySelectorAll(".resource-country")],lang="{{lang}}";
  const normalize=value=>String(value||"").normalize("NFD").replace(/[\u0300-\u036f]/g,"").toLowerCase().replace(/[^a-z0-9\u0600-\u06ff]+/g," ").trim();
  const countryNames={
    ar:{DZ:"الجزائر",AO:"أنغولا",BJ:"بنين",BW:"بوتسوانا",BF:"بوركينا فاسو",BI:"بوروندي",CV:"الرأس الأخضر",CM:"الكاميرون",CF:"جمهورية أفريقيا الوسطى",TD:"تشاد",KM:"جزر القمر",CI:"ساحل العاج",CD:"جمهورية الكونغو الديمقراطية",DJ:"جيبوتي",EG:"مصر",GQ:"غينيا الاستوائية",ER:"إريتريا",SZ:"إسواتيني",ET:"إثيوبيا",GA:"الغابون",GM:"غامبيا",GH:"غانا",GN:"غينيا",GW:"غينيا بيساو",KE:"كينيا",LS:"ليسوتو",LR:"ليبيريا",LY:"ليبيا",MG:"مدغشقر",MW:"ملاوي",ML:"مالي",MR:"موريتانيا",MU:"موريشيوس",MA:"المغرب",MZ:"موزمبيق",NA:"ناميبيا",NE:"النيجر",NG:"نيجيريا",CG:"جمهورية الكونغو",RW:"رواندا",SN:"السنغال",SC:"سيشل",SL:"سيراليون",SO:"الصومال",ZA:"جنوب أفريقيا",SS:"جنوب السودان",SD:"السودان",ST:"ساو تومي وبرينسيبي",TZ:"تنزانيا",TG:"توغو",TN:"تونس",UG:"أوغندا",ZM:"زامبيا",ZW:"زيمبابوي"},
    fr:{DZ:"Algérie",AO:"Angola",BJ:"Bénin",BW:"Botswana",BF:"Burkina Faso",BI:"Burundi",CV:"Cabo Verde",CM:"Cameroun",CF:"République centrafricaine",TD:"Tchad",KM:"Comores",CI:"Côte d’Ivoire",CD:"République démocratique du Congo",DJ:"Djibouti",EG:"Égypte",GQ:"Guinée équatoriale",ER:"Érythrée",SZ:"Eswatini",ET:"Éthiopie",GA:"Gabon",GM:"Gambie",GH:"Ghana",GN:"Guinée",GW:"Guinée-Bissau",KE:"Kenya",LS:"Lesotho",LR:"Libéria",LY:"Libye",MG:"Madagascar",MW:"Malawi",ML:"Mali",MR:"Mauritanie",MU:"Maurice",MA:"Maroc",MZ:"Mozambique",NA:"Namibie",NE:"Niger",NG:"Nigéria",CG:"République du Congo",RW:"Rwanda",SN:"Sénégal",SC:"Seychelles",SL:"Sierra Leone",SO:"Somalie",ZA:"Afrique du Sud",SS:"Soudan du Sud",SD:"Soudan",ST:"São Tomé-et-Príncipe",TZ:"Tanzanie",TG:"Togo",TN:"Tunisie",UG:"Ouganda",ZM:"Zambie",ZW:"Zimbabwe"},
    pt:{DZ:"Argélia",AO:"Angola",BJ:"Benim",BW:"Botsuana",BF:"Burquina Faso",BI:"Burundi",CV:"Cabo Verde",CM:"Camarões",CF:"República Centro-Africana",TD:"Chade",KM:"Comores",CI:"Costa do Marfim",CD:"República Democrática do Congo",DJ:"Djibuti",EG:"Egito",GQ:"Guiné Equatorial",ER:"Eritreia",SZ:"Essuatíni",ET:"Etiópia",GA:"Gabão",GM:"Gâmbia",GH:"Gana",GN:"Guiné",GW:"Guiné-Bissau",KE:"Quênia",LS:"Lesoto",LR:"Libéria",LY:"Líbia",MG:"Madagáscar",MW:"Maláui",ML:"Mali",MR:"Mauritânia",MU:"Maurício",MA:"Marrocos",MZ:"Moçambique",NA:"Namíbia",NE:"Níger",NG:"Nigéria",CG:"República do Congo",RW:"Ruanda",SN:"Senegal",SC:"Seicheles",SL:"Serra Leoa",SO:"Somália",ZA:"África do Sul",SS:"Sudão do Sul",SD:"Sudão",ST:"São Tomé e Príncipe",TZ:"Tanzânia",TG:"Togo",TN:"Tunísia",UG:"Uganda",ZM:"Zâmbia",ZW:"Zimbábue"},
    sw:{DZ:"Aljeria",AO:"Angola",BJ:"Benin",BW:"Botswana",BF:"Burkina Faso",BI:"Burundi",CV:"Cabo Verde",CM:"Kameruni",CF:"Jamhuri ya Afrika ya Kati",TD:"Chadi",KM:"Komoro",CI:"Côte d’Ivoire",CD:"Jamhuri ya Kidemokrasia ya Kongo",DJ:"Djibouti",EG:"Misri",GQ:"Guinea ya Ikweta",ER:"Eritrea",SZ:"Eswatini",ET:"Ethiopia",GA:"Gabon",GM:"Gambia",GH:"Ghana",GN:"Guinea",GW:"Guinea-Bissau",KE:"Kenya",LS:"Lesotho",LR:"Liberia",LY:"Libya",MG:"Madagaska",MW:"Malawi",ML:"Mali",MR:"Mauritania",MU:"Mauritius",MA:"Morocco",MZ:"Msumbiji",NA:"Namibia",NE:"Niger",NG:"Nigeria",CG:"Jamhuri ya Kongo",RW:"Rwanda",SN:"Senegal",SC:"Shelisheli",SL:"Sierra Leone",SO:"Somalia",ZA:"Afrika Kusini",SS:"Sudan Kusini",SD:"Sudan",ST:"São Tomé na Príncipe",TZ:"Tanzania",TG:"Togo",TN:"Tunisia",UG:"Uganda",ZM:"Zambia",ZW:"Zimbabwe"}
  };
  function localizedCountryName(code,english){
    const fallback=countryNames[lang]&&countryNames[lang][code];
    try{const names=new Intl.DisplayNames([lang],{type:"region"});const value=names.of(code);if(value&&value!==code&&value!==english)return value;}catch(_){}
    return fallback||english||code;
  }
  document.querySelectorAll("[data-resource-country-name]").forEach(el=>{el.textContent=localizedCountryName(el.dataset.resourceCountryName,el.textContent);});
  document.querySelectorAll(".resource-card[data-resource-country-code]").forEach(card=>{const english=card.dataset.resourceCountryName,localized=localizedCountryName(card.dataset.resourceCountryCode,english);if(!english||!localized||localized===english)return;card.querySelectorAll("strong,p").forEach(el=>{if(el.classList.contains("translation-pending-note"))return;el.textContent=el.textContent.split(english).join(localized);});});
  document.querySelectorAll("[data-regional-countries]").forEach(el=>{el.textContent=el.dataset.regionalCountries.split(",").map(code=>localizedCountryName(code,code)).join(", ");});
  c.querySelectorAll("option[data-country-code]").forEach(opt=>{opt.textContent=(opt.dataset.countryFlag||"")+" "+localizedCountryName(opt.dataset.countryCode,opt.dataset.countryName);});

  function f(){
