{% set L = labels[lang] or labels.en %}
<section class="section" style="padding-top:48px;">
<div class="container" style="max-width:1100px;" {% if lang=="ar" %}dir="rtl"{% endif %}>
<span class="eyebrow">{{L.eyebrow}}</span><h1>{{L.title}}</h1><p class="lede">{{L.intro}}</p>
<div style="display:grid;grid-template-columns:2fr 1fr 1fr;gap:12px;margin:28px 0 18px;">
<input id="resourceSearch" type="search" placeholder="{{L.search}}" aria-label="{{L.search}}" style="width:100%;padding:14px;border:1px solid var(--line);border-radius:10px;">
<select id="resourceCountry" aria-label="{{L.country}}" style="padding:14px;border:1px solid var(--line);border-radius:10px;"><option value="">{{L.country}}</option>{% for country in agriculturalResourcesAll.countries | sort(false,false,"name") %}<option value="{{country.code}}" data-country-code="{{country.code}}" data-country-flag="{{country.flag}}" data-country-name="{{country.name}}">{{country.flag}} {{country.name}}</option>{% endfor %}</select>
<select id="resourceCategory" aria-label="{{L.category}}" style="padding:14px;border:1px solid var(--line);border-radius:10px;"><option value="">{{L.category}}</option>{% for category in agriculturalResourcesAll.categories %}<option value="{{category}}">{{L[category] or category | replace("-"," ") | title}}</option>{% endfor %}</select>
</div>
<div style="display:flex;justify-content:space-between;gap:12px;align-items:center;margin:10px 0 18px;font-size:.92rem;"><strong id="resourceCount">{{agriculturalResourcesAll.total}} {{L.results}}</strong><span>{{agriculturalResourcesAll.countries|length}} {{L.coverage}}</span></div>
<p id="resourceEmpty" role="status" hidden style="padding:16px;border:1px dashed var(--line);border-radius:8px;">{{L.noResults}}</p>
<div id="resourceDirectory" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:14px;">
{% for country in agriculturalResourcesAll.countries | sort(false,false,"name") %}
<details class="resource-country" data-country="{{country.code}}" style="padding:14px;border:1px solid var(--line);border-radius:10px;"><summary style="cursor:pointer;font-weight:700;">{{country.flag}} <span class="resource-country-name" data-resource-country-name="{{country.code}}">{{country.name}}</span> <span style="opacity:.65;font-weight:400;">({{country.total}})</span></summary><div style="margin-top:12px;">
{% for category in agriculturalResourcesAll.categories %}{% if country.records[category] and country.records[category]|length %}
<h3 class="resource-category-heading" data-category="{{category}}" style="font-size:1rem;margin:16px 0 8px;">{{L[category] or category|replace("-"," ")|title}}</h3>
{% for record in country.records[category] %}{% set localizedRecord = record.localized[lang] if record.localized and record.localized[lang] else {} %}<article class="resource-card" data-category="{{category}}" data-search="{{(record.title ~ ' ' ~ record.description ~ ' ' ~ record.source ~ ' ' ~ (record.type or '') ~ ' ' ~ (record.tags or '') ~ ' ' ~ (record.access or '') ~ ' ' ~ (record.eligibility or '') ~ ' ' ~ (record.beneficiary or '') ~ ' ' ~ (record.deadline or '') ~ ' ' ~ (record.amount or '') ~ ' ' ~ (record.contact or '') ~ ' ' ~ (record.application_url or '') ~ ' ' ~ (localizedRecord.title or '') ~ ' ' ~ (localizedRecord.description or ''))|lower}}" style="padding:13px;margin:8px 0;border:1px solid var(--line);border-radius:8px;">{% if lang!="en" and record.localized and record.localized[lang] and record.localized[lang].title and record.localized[lang].description and (not record.translation_status or record.translation_status == "translated") %}
<strong>{{record.localized[lang].title}}</strong><p style="margin:6px 0;">{{record.localized[lang].description}}</p>
{% else %}
{% if lang!="en" %}<p class="translation-pending-note" data-translation-status="pending"><small>{{L.translationPending}}</small></p>{% endif %}
<strong>{{record.title}}</strong><p style="margin:6px 0;">{{record.description}}</p>
{% endif %}
{% if record.type %}<p class="resource-detail" data-resource-field="type" style="margin:5px 0;font-size:.9rem;"><strong>{{L.type}}:</strong> {{record.type}}</p>{% endif %}
{% if record.amount %}<p class="resource-detail" data-resource-field="amount" style="margin:5px 0;font-size:.9rem;"><strong>{{L.amount}}:</strong> {{record.amount}}</p>{% endif %}
{% if record.eligibility %}<p class="resource-detail" data-resource-field="eligibility" style="margin:5px 0;font-size:.9rem;"><strong>{{L.eligibility}}:</strong> {{record.eligibility}}</p>{% endif %}
{% if record.beneficiary %}<p class="resource-detail" data-resource-field="beneficiary" style="margin:5px 0;font-size:.9rem;"><strong>{{L.beneficiary}}:</strong> {{record.beneficiary}}</p>{% endif %}
{% if record.access %}<p class="resource-detail" data-resource-field="access" style="margin:5px 0;font-size:.9rem;"><strong>{{L.access}}:</strong> {{record.access}}</p>{% endif %}
{% if record.deadline %}<p class="resource-detail" data-resource-field="deadline" style="margin:5px 0;font-size:.9rem;"><strong>{{L.deadline}}:</strong> {{record.deadline}}</p>{% endif %}
{% if record.contact %}<p class="resource-detail" data-resource-field="contact" style="margin:5px 0;font-size:.9rem;"><strong>{{L.contact}}:</strong> {{record.contact}}</p>{% endif %}
{% if record.lifecycle == "expired" or record.status == "expired" %}<p class="resource-detail" data-resource-field="status" style="margin:5px 0;font-size:.9rem;"><strong>{{L.status}}:</strong> {{L.expired}}</p>{% elif record.lifecycle == "closed" or record.status == "closed" %}<p class="resource-detail" data-resource-field="status" style="margin:5px 0;font-size:.9rem;"><strong>{{L.status}}:</strong> {{L.closed}}</p>{% elif record.lifecycle == "historical" or record.status == "historical" %}<p class="resource-detail" data-resource-field="status" style="margin:5px 0;font-size:.9rem;"><strong>{{L.status}}:</strong> {{L.historical}}</p>{% endif %}
{% if record.application_url and record.application_url != record.url %}<p class="resource-detail" data-resource-field="application" style="margin:5px 0;font-size:.9rem;"><a data-resource-application-link="true" href="{{record.application_url}}" target="_blank" rel="noopener noreferrer">{{L.application}}</a></p>{% endif %}
<div style="font-size:.82rem;opacity:.78;">{{L.source}}: {{record.source}} · {{L.verified}}: {{record.verified}}{% if record.status == "official" %} · <span>{{L.official}}</span>{% endif %}{% if record.shared_coverage and record.shared_coverage|length > 1 %} · <span>{{L.shared}}</span>{% endif %}</div><a href="{{record.url}}" target="_blank" rel="noopener noreferrer">{{L.open}}</a></article>{% endfor %}{% endif %}{% endfor %}
</div></details>{% endfor %}
</div>
<section id="regionalAgriculturalIntelligence" style="margin-top:32px;padding:20px;border:1px solid var(--line);border-radius:12px;"><h2>{{L.regionalTitle}}</h2><p>{{L.regionalIntro}}</p>{% for region in agriculturalRegionalIntelligence.regions %}<article class="regional-resource-card" style="padding:15px;margin-top:12px;border:1px solid var(--line);border-radius:10px;"><strong>{{region.title}}</strong><p>{{region.description}}</p><div style="font-size:.82rem;opacity:.78;">{{region.countries|join(", ")}} · {{L.verified}}: {{region.verified}}</div><a href="{{region.url}}" target="_blank" rel="noopener noreferrer">{{L.open}}</a></article>{% endfor %}</section>
<div style="margin-top:32px;padding:20px;border:1px solid var(--line);border-radius:12px;"><h2>{{L.current}}</h2><p>{{L.currentText}}</p></div>
</div></section>
<script>
(function(){
  const s=document.getElementById("resourceSearch"),c=document.getElementById("resourceCountry"),k=document.getElementById("resourceCategory"),n=document.getElementById("resourceCount"),empty=document.getElementById("resourceEmpty"),g=[...document.querySelectorAll(".resource-country")],lang="{{lang}}";
  const normalize=value=>String(value||"").normalize("NFD").replace(/[\u0300-\u036f]/g,"").toLowerCase().replace(/[^a-z0-9\u0600-\u06ff]+/g," ").trim();
  try{
    const names=new Intl.DisplayNames([lang],{type:"region"});
    document.querySelectorAll("[data-resource-country-name]").forEach(el=>{const name=names.of(el.dataset.resourceCountryName);if(name&&name!==el.dataset.resourceCountryName)el.textContent=name;});
    c.querySelectorAll("option[data-country-code]").forEach(opt=>{const name=names.of(opt.dataset.countryCode);opt.textContent=(opt.dataset.countryFlag||"")+" "+(name&&name!==opt.dataset.countryCode?name:opt.dataset.countryName);});
  }catch(_){}
  function f(){
    const terms=normalize(s.value).split(/\s+/).filter(Boolean),cv=c.value,kv=k.value;let v=0;
    g.forEach(x=>{
      let z=0;
      x.querySelectorAll(".resource-card").forEach(a=>{
        const hay=normalize(a.dataset.search);
        const show=(!cv||x.dataset.country===cv)&&(!kv||a.dataset.category===kv)&&terms.every(term=>hay.includes(term));
        a.style.display=show?"block":"none";if(show){v++;z++;}
      });
      x.querySelectorAll(".resource-category-heading").forEach(h=>{h.style.display=[...x.querySelectorAll('.resource-card[data-category="'+h.dataset.category+'"]')].some(a=>a.style.display!=="none")?"block":"none";});
      x.style.display=z?"block":"none";if(terms.length||cv||kv)x.open=!!z;
    });
    n.textContent=v+" {{L.results}}";empty.hidden=v!==0;
  }
  [s,c,k].forEach(x=>x.addEventListener("input",f));[c,k].forEach(x=>x.addEventListener("change",f));f();
})();
</script>