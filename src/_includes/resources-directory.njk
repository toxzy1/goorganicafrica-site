{% set L = labels[lang] or labels.en %}
{% set countryNames = {
"fr": {
"DZ":"Algérie","AO":"Angola","BJ":"Bénin","BW":"Botswana","BF":"Burkina Faso","BI":"Burundi","CV":"Cap-Vert","CM":"Cameroun","CF":"République centrafricaine","TD":"Tchad","KM":"Comores","CI":"Côte d’Ivoire","CD":"République démocratique du Congo","DJ":"Djibouti","EG":"Égypte","GQ":"Guinée équatoriale","ER":"Érythrée","SZ":"Eswatini","ET":"Éthiopie","GA":"Gabon","GM":"Gambie","GH":"Ghana","GN":"Guinée","GW":"Guinée-Bissau","KE":"Kenya","LS":"Lesotho","LR":"Libéria","LY":"Libye","MG":"Madagascar","MW":"Malawi","ML":"Mali","MR":"Mauritanie","MU":"Maurice","MA":"Maroc","MZ":"Mozambique","NA":"Namibie","NE":"Niger","NG":"Nigéria","CG":"République du Congo","RW":"Rwanda","SN":"Sénégal","SC":"Seychelles","SL":"Sierra Leone","SO":"Somalie","ZA":"Afrique du Sud","SS":"Soudan du Sud","SD":"Soudan","ST":"Sao Tomé-et-Principe","TZ":"Tanzanie","TG":"Togo","TN":"Tunisie","UG":"Ouganda","ZM":"Zambie","ZW":"Zimbabwe"
}
} %}
<section class="section" style="padding-top:48px;">
<div class="container" style="max-width:1100px;" {% if lang=="ar" %}dir="rtl"{% endif %}>
<span class="eyebrow">{{L.eyebrow}}</span><h1>{{L.title}}</h1><p class="lede">{{L.intro}}</p>
<div style="display:grid;grid-template-columns:2fr 1fr 1fr;gap:12px;margin:28px 0 18px;">
<input id="resourceSearch" type="search" placeholder="{{L.search}}" aria-label="{{L.search}}" style="width:100%;padding:14px;border:1px solid var(--line);border-radius:10px;">
<select id="resourceCountry" aria-label="{{L.country}}" style="padding:14px;border:1px solid var(--line);border-radius:10px;"><option value="">{{L.country}}</option>{% for country in agriculturalResourcesAll.countries | sort(false,false,"name") %}<option value="{{country.code}}">{{country.flag}} {{(countryNames[lang] and countryNames[lang][country.code]) or country.name}}</option>{% endfor %}</select>
<select id="resourceCategory" aria-label="{{L.category}}" style="padding:14px;border:1px solid var(--line);border-radius:10px;"><option value="">{{L.category}}</option>{% for category in agriculturalResourcesAll.categories %}<option value="{{category}}">{{L[category] or category | replace("-"," ") | title}}</option>{% endfor %}</select>
</div>
<div style="display:flex;justify-content:space-between;gap:12px;align-items:center;margin:10px 0 18px;font-size:.92rem;"><strong id="resourceCount">{{agriculturalResourcesAll.total}} {{L.results}}</strong><span>{{agriculturalResourcesAll.countries|length}} {{L.coverage}}</span></div>
<div id="resourceDirectory" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:14px;">
{% for country in agriculturalResourcesAll.countries | sort(false,false,"name") %}
<details class="resource-country" data-country="{{country.code}}" style="padding:14px;border:1px solid var(--line);border-radius:10px;"><summary style="cursor:pointer;font-weight:700;">{{country.flag}} {{country.name}} <span style="opacity:.65;font-weight:400;">({{country.total}})</span></summary><div style="margin-top:12px;">
{% for category in agriculturalResourcesAll.categories %}{% if country.records[category] and country.records[category]|length %}
<h3 class="resource-category-heading" data-category="{{category}}" style="font-size:1rem;margin:16px 0 8px;">{{L[category] or category|replace("-"," ")|title}}</h3>
{% for record in country.records[category] %}<article class="resource-card" data-category="{{category}}" data-search="{{(record.title ~ ' ' ~ record.description ~ ' ' ~ record.source ~ ' ' ~ (record.type or '') ~ ' ' ~ (record.tags or ''))|lower}}" style="padding:13px;margin:8px 0;border:1px solid var(--line);border-radius:8px;">{% if lang!="en" and record.localized and record.localized[lang] and record.localized[lang].title and record.localized[lang].description and (not record.translation_status or record.translation_status == "translated") %}
<strong>{{record.localized[lang].title}}</strong><p style="margin:6px 0;">{{record.localized[lang].description}}</p>
{% else %}
{% if lang!="en" %}<p class="translation-pending-note" data-translation-status="pending"><small>{{L.translationPending}}</small></p>{% endif %}
<strong>{{record.title}}</strong><p style="margin:6px 0;">{{record.description}}</p>
{% endif %}<div style="font-size:.82rem;opacity:.78;">{{L.source}}: {{record.source}} · {{L.verified}}: {{record.verified}}{% if record.status == "official" %} · <span>{{L.official}}</span>{% endif %}{% if record.shared_coverage and record.shared_coverage|length > 1 %} · <span>{{L.shared}}</span>{% endif %}</div><a href="{{record.url}}" target="_blank" rel="noopener noreferrer">{{L.open}}</a></article>{% endfor %}{% endif %}{% endfor %}
</div></details>{% endfor %}
</div>
<section style="margin-top:32px;padding:20px;border:1px solid var(--line);border-radius:12px;"><h2>{{L.regionalTitle}}</h2><p>{{L.regionalIntro}}</p>{% for region in agriculturalRegionalIntelligence.regions %}<article style="padding:15px;margin-top:12px;border:1px solid var(--line);border-radius:10px;"><strong>{{region.title}}</strong><p>{{region.description}}</p><div style="font-size:.82rem;opacity:.78;">{{region.countries|join(", ")}} · {{L.verified}}: {{region.verified}}</div><a href="{{region.url}}" target="_blank" rel="noopener noreferrer">{{L.open}}</a></article>{% endfor %}</section>
<div style="margin-top:32px;padding:20px;border:1px solid var(--line);border-radius:12px;"><h2>{{L.current}}</h2><p>{{L.currentNote}}</p></div>
</div></section>
<script>
(function(){const s=document.getElementById("resourceSearch"),c=document.getElementById("resourceCountry"),k=document.getElementById("resourceCategory"),n=document.getElementById("resourceCount"),g=[...document.querySelectorAll(".resource-country")];function f(){let q=(s.value||"").toLowerCase().trim(),cv=c.value,kv=k.value,v=0;g.forEach(x=>{let z=0;x.querySelectorAll(".resource-card").forEach(a=>{let show=(!cv||x.dataset.country===cv)&&(!kv||a.dataset.category===kv)&&(!q||a.dataset.search.includes(q));a.style.display=show?"block":"none";if(show){v++;z++;}});x.querySelectorAll(".resource-category-heading").forEach(h=>{h.style.display=[...x.querySelectorAll('.resource-card[data-category="'+h.dataset.category+'"]')].some(a=>a.style.display!=="none")?"block":"none"});x.style.display=z?"block":"none";if(q||cv||kv)x.open=!!z});n.textContent=v+" {{L.results}}"}[s,c,k].forEach(x=>x.addEventListener("input",f));[c,k].forEach(x=>x.addEventListener("change",f))})();
</script>