<section class="container" style="max-width:1100px;margin:0 auto;padding:24px 16px;">
  <header style="margin-bottom:24px">
    <h1 data-i18n="opportunities.title">Agricultural Opportunities</h1>
    <p data-i18n="opportunities.intro">Verified grants, funding calls, investment programmes and agricultural opportunities. Open opportunities are shown first; closed opportunities remain in the archive.</p>
    <select id="opportunity-category" style="padding:10px;margin-right:8px"><option value="all" data-i18n="opportunities.allTypes">All types</option><option value="grants" data-i18n="opportunities.grants">Grants</option><option value="investment" data-i18n="opportunities.investment">Investment</option><option value="finance" data-i18n="opportunities.finance">Finance</option><option value="training" data-i18n="opportunities.training">Training</option><option value="programme" data-i18n="opportunities.programmes">Programmes</option><option value="competition" data-i18n="opportunities.competitions">Competitions</option><option value="procurement" data-i18n="opportunities.procurement">Procurement / EOIs</option><option value="research" data-i18n="opportunities.research">Research</option></select>
    <input id="opportunity-search" type="search" placeholder="Search opportunities..." aria-label="Search opportunities" data-i18n-placeholder="opportunities.searchPlaceholder" data-i18n-aria-label="opportunities.searchAria" style="width:100%;padding:12px;margin:12px 0">
    <select id="opportunity-status" style="padding:10px"><option value="current" data-i18n="opportunities.openOpportunities">Open opportunities</option><option value="all" data-i18n="opportunities.allOpportunities">All opportunities</option><option value="expired" data-i18n="opportunities.expiredArchived">Expired / archived</option></select>
  </header>
  <p id="opportunity-empty" data-i18n="opportunities.noResults" hidden>No matching opportunities. Try another search or status filter.</p>
  <div id="opportunity-list">
  {% for record in agriculturalOpportunities.records %}
    {# Never render automated candidates until an editor approves them. #}
    {% if (record.status == "open" or record.status == "active" or record.status == "closed" or record.status == "expired" or record.status == "archived") and record.lifecycle != "review" and record.lifecycle != "needs_review" and record.lifecycle != "draft" %}
    {% set localized = record.localized or {} %}
    <article class="opportunity-card" data-status="{{ record.lifecycle or record.status }}" data-deadline="{{ record.deadline or record.closing_date or record.expiry_date or '' }}" data-category="{{ record.category }}" data-original-search="{{ record.title }} {{ record.country }} {{ record.category }} {{ record.type }} {{ record.eligibility }} {{ record.summary }} {{ (record.tags or []) | join(' ') }}" style="border:1px solid #ddd;border-radius:10px;padding:18px;margin:12px 0">
      <div style="font-size:.9em"><span class="opportunity-country" data-code="{{ record.code }}" data-en="{{ record.country | escape }}" data-fr="{{ localized.fr.country | default(record.country) | escape }}" data-ar="{{ localized.ar.country | default(record.country) | escape }}" data-pt="{{ localized.pt.country | default(record.country) | escape }}" data-sw="{{ localized.sw.country | default(record.country) | escape }}">{{ record.country }}</span> · <span class="opportunity-category" data-i18n="opportunities.{{ record.category }}">{{ record.category }}</span></div>
      <h2 class="opportunity-title" style="margin:8px 0" data-en="{{ record.title | escape }}" data-fr="{{ localized.fr.title | default(record.title) | escape }}" data-ar="{{ localized.ar.title | default(record.title) | escape }}" data-pt="{{ localized.pt.title | default(record.title) | escape }}" data-sw="{{ localized.sw.title | default(record.title) | escape }}">{{ record.title }}</h2>
      <p class="opportunity-summary" data-en="{{ record.summary | escape }}" data-fr="{{ localized.fr.summary | default(record.summary) | escape }}" data-ar="{{ localized.ar.summary | default(record.summary) | escape }}" data-pt="{{ localized.pt.summary | default(record.summary) | escape }}" data-sw="{{ localized.sw.summary | default(record.summary) | escape }}">{{ record.summary }}</p>
      <p><strong data-i18n="opportunities.eligibilityLabel">Eligibility:</strong> <span class="opportunity-eligibility" data-en="{{ record.eligibility | default('') | escape }}" data-fr="{{ localized.fr.eligibility | default('') | escape }}" data-ar="{{ localized.ar.eligibility | default('') | escape }}" data-pt="{{ localized.pt.eligibility | default('') | escape }}" data-sw="{{ localized.sw.eligibility | default('') | escape }}">{{ record.eligibility or '' }}</span></p>
      {% if record.deadline %}<p><strong data-i18n="opportunities.deadlineLabel">Deadline:</strong> {{ record.deadline }}</p>{% endif %}
      <p><strong data-i18n="opportunities.sourceLabel">Source:</strong> {{ record.source }} · <span data-i18n="opportunities.verifiedLabel">Verified</span> {{ record.verified }}</p>
      {% set statusKey = "opportunities.openStatus" %}
      {% if record.status == "expired" or record.status == "closed" or record.status == "archived" or record.lifecycle == "expired" %}{% set statusKey = "opportunities.expiredArchivedStatus" %}{% elif record.status == "active" %}{% set statusKey = "opportunities.activeStatus" %}{% endif %}
      <p><strong data-i18n="opportunities.statusLabel">Status:</strong> <span class="opportunity-status-text" data-i18n="{{ statusKey }}"></span></p>
      <a href="{{ record.url }}" target="_blank" rel="noopener noreferrer" data-i18n="opportunities.viewOfficialSource">View official source</a>
    </article>
    {% endif %}
  {% endfor %}
  </div>
</section>
<script>
(() => {
 const input=document.getElementById('opportunity-search'), select=document.getElementById('opportunity-status'), category=document.getElementById('opportunity-category'), empty=document.getElementById('opportunity-empty');
 const cards=[...document.querySelectorAll('.opportunity-card')];
 function lang(){return window.GOA_I18N&&window.GOA_I18N.lang?window.GOA_I18N.lang():(document.documentElement.lang||'en');}
 function updateTitle(){document.title=window.GOA_I18N&&window.GOA_I18N.t?window.GOA_I18N.t('opportunities','title')+' | GoOrganicAfrica':'Agricultural Opportunities | GoOrganicAfrica';}
 function localizeCards(code){const current=['fr','ar','pt','sw'].includes(code)?code:'en';cards.forEach(c=>{c.querySelectorAll('.opportunity-title,.opportunity-summary,.opportunity-eligibility,.opportunity-country').forEach(el=>{let value=el.getAttribute('data-'+current)||el.getAttribute('data-en')||'';if(el.classList.contains('opportunity-country')&&current!=='en'){const code=el.getAttribute('data-code')||'',english=el.getAttribute('data-en')||'';const regional={'Central Sahel':{fr:'Sahel central',ar:'وسط الساحل',pt:'Sahel Central',sw:'Sahel ya Kati'},'West & Central Africa':{fr:'Afrique de l’Ouest et centrale',ar:'غرب ووسط أفريقيا',pt:'África Ocidental e Central',sw:'Afrika Magharibi na Kati'},'West Africa':{fr:'Afrique de l’Ouest',ar:'غرب أفريقيا',pt:'África Ocidental',sw:'Afrika Magharibi'},'Africa':{fr:'Afrique',ar:'أفريقيا',pt:'África',sw:'Afrika'}};if(regional[english]){value=regional[english][current]||value;}else if(code&&code.length===2){try{const names=new Intl.DisplayNames([current],{type:'region'});value=names.of(code)||value;}catch(_){}}}if(el.classList.contains('opportunity-eligibility')&&!value.trim()){value=window.GOA_I18N&&window.GOA_I18N.t?window.GOA_I18N.t('opportunities','noEligibility'):'Check the official source for eligibility and application details.';}el.textContent=value;});});
 if(window.GOA_I18N&&window.GOA_I18N.translate)cards.forEach(c=>window.GOA_I18N.translate(c,current));
 }
 function filter(){const q=input.value.toLowerCase().trim(), s=select.value, cat=category.value;let visible=0;const today=new Date();today.setHours(0,0,0,0);const current=lang();cards.forEach(c=>{const status=(c.dataset.status||'').toLowerCase();let lifecycle=(status==='expired'||status==='closed'||status==='archived')?'expired':'current';const deadline=(c.dataset.deadline||'').trim();if(lifecycle==='current'&&/^\d{4}-\d{2}-\d{2}$/.test(deadline)){const cutoff=new Date(deadline+'T00:00:00');if(!Number.isNaN(cutoff.getTime())&&cutoff<today)lifecycle='expired';}const statusText=c.querySelector('.opportunity-status-text');if(statusText){statusText.setAttribute('data-i18n',lifecycle==='expired'?'opportunities.expiredArchivedStatus':(status==='active'?'opportunities.activeStatus':'opportunities.openStatus'));if(window.GOA_I18N&&window.GOA_I18N.translate)window.GOA_I18N.translate(statusText.parentElement,current);}const okS=s==='all'||lifecycle===s;const okC=cat==='all'||c.dataset.category===cat;const okQ=!q||((c.dataset.originalSearch||'')+' '+c.innerText).toLowerCase().includes(q);c.hidden=!(okS&&okC&&okQ);if(!c.hidden)visible++;});if(empty)empty.hidden=visible>0;}
 input.addEventListener('input',filter);select.addEventListener('change',filter);category.addEventListener('change',filter);
 document.addEventListener('goa:languagechange',event=>{localizeCards(event.detail&&event.detail.language||'en');filter();updateTitle();});
 if(window.GOA_I18N&&window.GOA_I18N.ready){window.GOA_I18N.ready.then(()=>{localizeCards(lang());filter();updateTitle();});}else{localizeCards(lang());filter();updateTitle();}
})();
</script>