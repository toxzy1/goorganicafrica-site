<section class="section" style="padding-top: 48px;">
  <div class="container">
    <div id="goa-language-targets" aria-hidden="true" style="display:none;" data-url-en="/blog/" data-url-fr="/fr/blog/" data-url-ar="/ar/blog/" data-url-pt="/pt/blog/" data-url-sw="/sw/blog/"></div>

    <div class="section-head">
      <span class="eyebrow" data-i18n="blog.eyebrow">The Blog</span>
      <h1 data-i18n="blog.title">GoOrganicAfrica Farming Blog</h1>
      <p class="lede" data-i18n="blog.description">Practical, research-backed articles to help African farmers make better decisions and grow more profitably.</p>
    </div>

    <h2 style="font-size:1.2rem;color:var(--green-deep);margin-bottom:16px;" data-i18n="blog.browseCategory">Browse by Category</h2>

    <div class="category-grid" style="margin-bottom: 40px;">
      {% for cat in collections.blogCategories %}
        {% if cat.data.active != false %}
        {% set categoryKey = cat.data.slug %}
        {% if cat.data.slug == "crop-production" %}{% set categoryKey = "crop" %}{% endif %}
        {% if cat.data.slug == "livestock-farming" %}{% set categoryKey = "livestock" %}{% endif %}
        {% if cat.data.slug == "organic-farming" %}{% set categoryKey = "organic" %}{% endif %}
        {% if cat.data.slug == "agribusiness" %}{% set categoryKey = "agribusiness" %}{% endif %}
        {% if cat.data.slug == "farm-inputs" %}{% set categoryKey = "inputs" %}{% endif %}
        {% if cat.data.slug == "farming-data" %}{% set categoryKey = "markets" %}{% endif %}
        <div class="category-card">
          <h3 data-i18n="blog.categories.{{ categoryKey }}">{{ cat.data.title }}</h3>
          <p data-i18n="blog.categoryDescriptions.{{ categoryKey }}">{{ cat.data.description }}</p>
        </div>
        {% endif %}
      {% endfor %}
    </div>

    {% set localizedPosts = collections.posts | filterByLanguage(pageLanguage) %}
    {% if localizedPosts.length > 0 %}
    <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:24px;">
      {% for post in localizedPosts %}
      {% if (post.data.translation_status or "published") != "in_review" %}
      <a href="{{ post.url }}" style="text-decoration:none;">
        <div class="ebook-card" style="height:100%;">
          {% if post.data.featured_image %}
          <img src="{{ post.data.featured_image }}" alt="{{ post.data.title }}" style="width:100%;height:180px;object-fit:cover;border-radius:4px;">
          {% endif %}
          <span class="eyebrow" style="font-size:0.68rem;">{{ post.data.category }}</span>
          <h3 style="font-size:1.05rem;">{{ post.data.title }}</h3>
          <p class="tagline" style="font-size:0.88rem;">{{ post.data.description }}</p>
          <div class="card-footer">
            <span style="font-size:0.8rem;color:var(--ink-soft);" data-i18n="blog.readArticle">Read article</span>
            <span class="cta">&rarr;</span>
          </div>
        </div>
      </a>
      {% endif %}
      {% endfor %}
    </div>
    {% else %}
    <div class="empty-state">
      <p data-i18n="blog.empty">Articles are being written and will appear here soon.</p>
    </div>
    {% endif %}

    <div style="text-align:center;margin-top:40px;">
      <a class="btn btn-primary" href="/farm-profit-calculator/" data-i18n="blog.tryCalculator">Try the Free Farm Profit Calculator</a>
    </div>
  </div>
</section>