{% include "partials/language-selectors/blog.njk" %}

<section class="section blog-index-section" style="padding-top:48px;">
  <div class="container">

    <div class="section-head">
      <span class="eyebrow" data-i18n="blog.eyebrow">The Blog</span>
      <h1 data-i18n="blog.title">GoOrganicAfrica Farming Blog</h1>
      <p class="lede" data-i18n="blog.description">Practical, research-backed articles to help African farmers make better decisions and grow more profitably.</p>
    </div>

    <h2 style="font-size:1.2rem;color:var(--green-deep);margin-bottom:16px;" data-i18n="blog.browseCategory">Browse by Category</h2>

    {% set currentLanguage = pageLanguage or language or "en" %}
    {% set categoryTranslations = (siteTranslations[currentLanguage]).translations.blog.categories %}
    {% set categoryDescriptionTranslations = (siteTranslations[currentLanguage]).translations.blog.categoryDescriptions %}
    <div class="category-grid" style="margin-bottom:40px;">
      {% for cat in collections.blogCategories %}
        {% if cat.data.active != false %}
          {% set categoryKey = cat.data.slug %}
          {% if cat.data.slug == "crop-production" %}{% set categoryKey = "crop" %}{% endif %}
          {% if cat.data.slug == "livestock-farming" %}{% set categoryKey = "livestock" %}{% endif %}
          {% if cat.data.slug == "organic-farming" or cat.data.slug == "organic-fertilizers" %}{% set categoryKey = "organic" %}{% endif %}
          {% if cat.data.slug == "agribusiness" or cat.data.slug == "farm-business" %}{% set categoryKey = "agribusiness" %}{% endif %}
          {% if cat.data.slug == "farm-inputs" %}{% set categoryKey = "inputs" %}{% endif %}
          {% if cat.data.slug == "farming-data" %}{% set categoryKey = "markets" %}{% endif %}

          {% set categoryTitle = categoryTranslations[categoryKey] or cat.data.title %}
          {% set categoryDescription = categoryDescriptionTranslations[categoryKey] or cat.data.description %}

          {% if currentLanguage == "sw" and cat.data.slug == "organic-fertilizers" %}
            {% set categoryTitle = "Mbolea Hai na Afya ya Udongo" %}
            {% set categoryDescription = "Mbolea hai, usimamizi wa virutubisho na kujenga udongo wenye afya kwa njia za kikaboni." %}
          {% endif %}
          {% if currentLanguage == "sw" and cat.data.slug == "farm-business" %}
            {% set categoryTitle = "Biashara ya Kilimo na Masoko" %}
            {% set categoryDescription = "Gharama, kuongeza uzalishaji na kuuza mazao kwa faida." %}
          {% endif %}

          <div class="category-card">
            <h3>{{ categoryTitle }}</h3>
            <p>{{ categoryDescription }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% set localizedPosts = collections.posts | filterByLanguage(currentLanguage) %}

    {% if localizedPosts.length > 0 %}
      <div class="blog-card-grid">
        {% for post in localizedPosts %}
          {% if (post.data.translation_status or "published") != "in_review" %}
            <article class="blog-list-card">
              <a href="{{ post.url }}" class="ebook-card" style="height:100%;text-decoration:none;display:flex;flex-direction:column;">
                {% if post.data.featured_image %}
                  <img src="{{ post.data.featured_image }}"
                       alt="{{ post.data.title }}"
                       loading="lazy"
                       style="width:100%;height:190px;object-fit:cover;border-radius:4px;">
                {% endif %}

                <div style="display:flex;flex-direction:column;flex:1;">
                  <span class="eyebrow" style="font-size:.68rem;margin-top:14px;">{{ post.data.category }}</span>
                  <h2 style="font-size:1.08rem;margin-top:8px;">{{ post.data.title }}</h2>
                  {% if post.data.description %}
                    <p class="tagline" style="font-size:.88rem;">{{ post.data.description }}</p>
                  {% endif %}
                  <div class="card-footer" style="margin-top:auto;">
                    <span style="font-size:.8rem;color:var(--ink-soft);" data-i18n="blog.readArticle">Read article</span>
                    <span class="cta" aria-hidden="true">&rarr;</span>
                  </div>
                </div>
              </a>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <div class="empty-state">
        <p data-i18n="blog.empty">Articles are being written and will appear here soon.</p>
      </div>
    {% endif %}

    <div style="text-align:center;margin-top:40px;">
      <a class="btn btn-primary" href="/farm-profit-calculator/" data-i18n="blog.tryCalculator">Try the Free Farm Profit Calculator</a>
    </div>

  </div>
</section>
