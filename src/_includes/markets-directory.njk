<section class="container" style="max-width:1100px;margin:0 auto;padding:24px 16px;">
<header style="margin-bottom:24px">
<h1 data-i18n="markets.title">Agricultural Markets</h1>
<p data-i18n="markets.intro">Verified agricultural market intelligence, price-monitoring sources and regional market signals. A price is current only when it has a defined market, commodity, unit and observation date.</p>
<input id="market-search" type="search" placeholder="Search commodity, market, country or source..." aria-label="Search markets" data-i18n-placeholder="markets.searchPlaceholder" data-i18n-aria-label="markets.searchAria" style="width:100%;padding:12px;margin:12px 0">
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:8px">
<select id="market-country" style="padding:10px"><option value="all" data-i18n="markets.allCountries">All countries</option>{% for r in agriculturalMarkets.country_source_map %}<option value="{{ r.country_code }}">{{ r.country }}</option>{% endfor %}</select>
<select id="market-commodity" style="padding:10px"><option value="all" data-i18n="markets.allCommodities">All commodities</option>{% for commodity in agriculturalMarkets.commodities %}<option value="{{ commodity }}">{{ commodity }}</option>{% endfor %}</select>
<select id="market-freshness" style="padding:10px"><option value="all" data-i18n="markets.allFreshness">All freshness</option><option value="recent" data-i18n="markets.recent">Recent</option><option value="older" data-i18n="markets.older">Older</option><option value="stale" data-i18n="markets.stale">Stale</option><option value="source_reference" data-i18n="markets.sourceReference">Source reference</option></select>
<select id="market-price-type" style="padding:10px"><option value="all" data-i18n="markets.allPriceTypes">All price types</option>{% for price_type in agriculturalMarkets.price_types %}<option value="{{ price_type }}">{{ price_type }}</option>{% endfor %}</select>
</div>
<p id="market-summary" data-i18n="markets.summary" data-i18n-vars='{"recent":"{{ agriculturalMarkets.current_total }}","sources":"{{ agriculturalMarkets.source_reference_total }}","total":"{{ agriculturalMarkets.total }}"}' style="margin:12px 0 0;font-size:.95em">{{ agriculturalMarkets.current_total }} recent market records · {{ agriculturalMarkets.source_reference_total }} source references · {{ agriculturalMarkets.total }} total records</p>
</header>
<section id="market-signals" style="margin:20px 0">
<h2 data-i18n="markets.signalsTitle">Market movement signals</h2>
<p data-i18n="markets.signalsIntro">Signals use comparable dated price observations. They are indicators, not forecasts.</p>
{% if agriculturalMarkets.market_signals.length %}<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px">
{% for s in agriculturalMarkets.market_signals | reverse %}<article style="border:1px solid #ddd;border-radius:10px;padding:16px"><strong>{{ s.country }} · {{ s.commodity }}</strong><p>{% if s.trend == "rising" %}↑ <span data-i18n="markets.rising">Rising</span>{% elif s.trend == "falling" %}↓ <span data-i18n="markets.falling">Falling</span>{% else %}→ <span data-i18n="markets.stable">Stable</span>{% endif %} · {{ s.change_percent }}%</p><small><span data-market-date="{{ s.observed_date }}">{{ s.observed_date }}</span> <span data-market-compared-label="compared with">compared with</span> <span data-market-date="{{ s.previous_observed_date }}">{{ s.previous_observed_date }}</span></small></article>{% endfor %}</div>{% else %}<p data-i18n="markets.noMovements">No notable comparable movements are currently available.</p>{% endif %}
</section>
<p id="market-empty" data-i18n="markets.noResults" hidden>No matching market records. Try another filter.</p>
<div id="market-list">
{% for r in agriculturalMarkets.records %}
<article class="market-card" data-country="{{ r.country_code }}" data-commodity="{{ r.commodity }}" data-freshness="{{ r.freshness }}" data-price-type="{{ r.price_type }}" data-search="{{ r.country }} {{ r.market }} {{ r.commodity }} {{ r.source }}" style="border:1px solid #ddd;border-radius:10px;padding:18px;margin:12px 0">
<div style="font-size:.9em">{{ r.country }} · {{ r.market }} · {{ r.commodity }}</div>
<h2 style="margin:8px 0">{{ r.commodity }}</h2>
{% if r.price %}<p><strong data-i18n="markets.priceLabel">Price:</strong> {{ r.price }} {{ r.currency }} / {{ r.unit }}</p>{% else %}<p><strong data-i18n="markets.priceLabel">Price:</strong> <span data-i18n="markets.sourceReferencePrice">Source reference — no current quotation is displayed.</span></p>{% endif %}
<p><strong data-i18n="markets.freshnessLabel">Freshness:</strong> {{ r.freshness | replace("_", " ") | title }}{% if r.observed_date %} · <span data-i18n="markets.observationLabel">Observation:</span> <span data-market-date="{{ r.observed_date }}">{{ r.observed_date }}</span>{% endif %}</p>
{% if r.trend and r.trend != "baseline" %}<p><strong data-i18n="markets.trendLabel">Trend:</strong> {% if r.trend == "rising" %}↑ <span data-i18n="markets.rising">Rising</span>{% elif r.trend == "falling" %}↓ <span data-i18n="markets.falling">Falling</span>{% else %}→ <span data-i18n="markets.stable">Stable</span>{% endif %}{% if r.change_percent is defined and r.change_percent is not null %} ({{ r.change_percent }}%){% endif %}{% if r.previous_observed_date %} · <span data-i18n="markets.previousLabel">Previous:</span> <span data-market-date="{{ r.previous_observed_date }}">{{ r.previous_observed_date }}</span>{% endif %}</p>{% endif %}
<p><strong data-i18n="markets.sourceLabel">Source:</strong> {{ r.source }}</p>
<p><strong data-i18n="markets.verifiedLabel">Verified:</strong> <span data-market-date="{{ r.verified }}">{{ r.verified }}</span></p>
{% if r.note %}<p>{{ r.note }}</p>{% endif %}
<a href="{{ r.source_url }}" target="_blank" rel="noopener noreferrer" data-i18n="markets.viewMarketSource">View official market source</a>
</article>
{% endfor %}
</div>
<section style="margin:24px 0"><h2 data-i18n="markets.indicatorsTitle">Market indicators</h2><p data-i18n="markets.indicatorsIntro">Official economic indicators provide context for market conditions; they are not substitutes for commodity quotations.</p>{% for r in agriculturalMarkets.market_indicators %}<article style="border:1px solid #ddd;border-radius:10px;padding:16px;margin:10px 0"><strong>{{ r.country }} · {{ r.indicator }}</strong><p><b>{{ r.value }} {{ r.unit }}</b> · <span data-i18n="markets.periodLabel">Period:</span> {{ r.period }}</p><small><span data-i18n="markets.observedLabel">Observed</span> <span data-market-date="{{ r.observed_date }}">{{ r.observed_date }}</span> · <span data-i18n="markets.verifiedLabel">Verified:</span> <span data-market-date="{{ r.verified }}">{{ r.verified }}</span> · {{ r.source }}</small><p>{{ r.note }}</p><a href="{{ r.source_url }}" target="_blank" rel="noopener noreferrer" data-i18n="markets.openOfficialSource">Open official source</a></article>{% endfor %}</section>
<h2 data-i18n="markets.coverageTitle">54-country market-source coverage</h2>
<p data-i18n="markets.coverageIntro">Every GoOrganicAfrica country profile has a verified market-information starting point. Regional systems are used where they provide broader coverage; FAO FPMA is the continental fallback. This is a source map, not a claim that every country has a live national quotation today.</p>
<div id="market-source-map" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px">
{% for r in agriculturalMarkets.country_source_map %}
<article class="market-source-card" data-country="{{ r.country_code }}" data-search="{{ r.country }} {{ r.primary_market_source }} {{ r.coverage }}" style="border:1px solid #ddd;border-radius:10px;padding:16px">
<strong>{{ r.country }}</strong><p style="margin:6px 0">{{ r.primary_market_source }}</p><small data-market-scope-label data-market-scope="{{ r.source_scope | title }}" data-market-tier="{{ r.source_tier }}" data-market-verified="{{ r.verified }}">{{ r.source_scope | title }} source · Tier {{ r.source_tier }} · Verified {{ r.verified }}</small><p>{{ r.coverage }}</p><a href="{{ r.source_url }}" target="_blank" rel="noopener noreferrer" data-i18n="markets.openOfficialSource">Open official source</a>
</article>
{% endfor %}
</div>
<h2 data-i18n="markets.regionalSignalsTitle">Regional market signals</h2>
{% for r in agriculturalMarkets.regional_roundups %}
<article style="border:1px solid #ddd;border-radius:10px;padding:16px;margin:10px 0">
<strong>{{ r.region }}</strong><p>{{ r.title }}</p><small>{{ r.source }} · <span data-market-date="{{ r.published }}">{{ r.published }}</span> · <span data-market-word="verified">Verified</span> <span data-market-date="{{ r.verified }}">{{ r.verified }}</span></small><br><a href="{{ r.url }}" target="_blank" rel="noopener noreferrer" data-i18n="markets.viewSource">View source</a>
</article>
{% endfor %}
<section style="margin-top:28px"><h2 data-i18n="markets.internationalBenchmarksTitle">International market benchmarks</h2><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px">{% for r in agriculturalMarkets.market_intelligence.international %}<article style="border:1px solid #ddd;border-radius:10px;padding:16px"><strong>{{ r.provider }}</strong><p>{{ r.coverage }}</p><small><span data-market-scope-value="{{ r.scope | title }}">{{ r.scope | title }}</span> · <span data-market-word="tier">Tier</span> {{ r.source_tier }} · <span data-market-word="verified">Verified</span> <span data-market-date="{{ r.verified }}">{{ r.verified }}</span></small><p><a href="{{ r.url }}" target="_blank" rel="noopener noreferrer" data-i18n="markets.openOfficialSource">Open official source</a></p></article>{% endfor %}</div><h3 data-i18n="markets.howInterpretedTitle">How market data is interpreted</h3><ul>{% for rule in agriculturalMarkets.market_intelligence.interpretation_rules %}<li>{{ rule }}</li>{% endfor %}</ul></section></section>
<script src="/js/market-commodity-localization.js?v=20261019-market-date-labels-v2"></script>
<script>
(()=>{const q=document.getElementById('market-search'),c=document.getElementById('market-country'),m=document.getElementById('market-commodity'),fsh=document.getElementById('market-freshness'),pt=document.getElementById('market-price-type'),summary=document.getElementById('market-summary'),empty=document.getElementById('market-empty'),cards=[...document.querySelectorAll('.market-card')],sources=[...document.querySelectorAll('.market-source-card')];function t(key,vars,fallback){return window.GOA_I18N&&window.GOA_I18N.t?window.GOA_I18N.t('markets',key,vars):fallback;}function updateTitle(){document.title=t('title',{},'Agricultural Markets')+' | GoOrganicAfrica';}function f(){const s=q.value.toLowerCase().trim(),cc=c.value,cm=m.value,fr=fsh.value,typ=pt.value;let shown=0;cards.forEach(x=>{const ok=(cc==='all'||x.dataset.country===cc)&&(cm==='all'||x.dataset.commodity===cm)&&(fr==='all'||x.dataset.freshness===fr)&&(typ==='all'||x.dataset.priceType===typ)&&(!s||x.dataset.search.toLowerCase().includes(s));x.hidden=!ok;if(ok)shown++;});sources.forEach(x=>{x.hidden=!((cc==='all'||x.dataset.country===cc)&&(!s||x.dataset.search.toLowerCase().includes(s)));});const sourceCount=sources.filter(x=>!x.hidden).length;summary.textContent=t('matchingSummary',{shown:shown,sources:sourceCount},shown+' matching market records · '+sourceCount+' matching country source entries');if(empty)empty.hidden=shown>0;}q.addEventListener('input',f);c.addEventListener('change',f);m.addEventListener('change',f);fsh.addEventListener('change',f);pt.addEventListener('change',f);document.addEventListener('goa:languagechange',()=>{f();updateTitle();});f();updateTitle();})();
</script>