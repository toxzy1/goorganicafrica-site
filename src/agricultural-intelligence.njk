---
layout: layouts/base.njk
title: Agricultural Intelligence Hub
permalink: /agricultural-intelligence/
---

<div class="container" style="padding-top:2rem;padding-bottom:3rem;">
  <div class="section-head">
    <span class="eyebrow" data-i18n="agriculturalIntelligence.eyebrow">Connected Agriculture</span>
    <h1 data-i18n="agriculturalIntelligence.title">Agricultural Intelligence Hub</h1>
    <p class="lede" data-i18n="agriculturalIntelligence.intro">Connect countries with agricultural resources, markets, opportunities, services and news so you can move from information to action.</p>
  </div>
  <div style="margin:1.25rem 0;">
    <label for="ai-search"><strong data-i18n="agriculturalIntelligence.searchLabel">Search connected intelligence</strong></label>
    <input id="ai-search" type="search" placeholder="Try Nigeria, maize, finance, irrigation, machinery..." aria-label="Search connected agricultural intelligence" data-i18n-placeholder="agriculturalIntelligence.searchPlaceholder" data-i18n-aria-label="agriculturalIntelligence.searchAria" style="width:100%;max-width:720px;padding:12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;">
    <p style="margin:.5rem 0 0;"><span data-i18n="agriculturalIntelligence.searchHint">Search by country, topic, section or record title. Results link directly to the relevant source or directory.</span>.</p>
  </div>
  <div id="ai-results"></div>
  <div style="margin-top:2rem;">
    <h2 data-i18n="agriculturalIntelligence.connectionsTitle">Value-chain & topic connections</h2>
    <p data-i18n="agriculturalIntelligence.connectionsIntro">These connections appear only where a topic is present in indexed records. Select a topic to search across connected sections.</p>
    <div id="ai-topics" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;"></div>
  </div>
</div>

<script>
(function(){
  const data = {{ agriculturalKnowledgeConnections.records | jsonify }};
  const records = {{ agriculturalDecisionCentre.records | jsonify }};
  const topics = {{ agriculturalTopicConnections.topics | jsonify }};
  const input = document.getElementById('ai-search'), out = document.getElementById('ai-results'), topicOut = document.getElementById('ai-topics');
  function t(key,vars,fallback){return window.GOA_I18N&&window.GOA_I18N.t?window.GOA_I18N.t('agriculturalIntelligence',key,vars):fallback;}
  function topicLabel(key,fallback){return window.GOA_I18N&&window.GOA_I18N.t?(window.GOA_I18N.t('myAgriculture','topic_'+key)||fallback):fallback;}
  function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
  function sectionLabel(key){return t('section_'+key,{},key);}
  function sectionUrl(key){return ({markets:'/markets/',opportunities:'/opportunities/',resources:'/agriculture-resources/',services:'/agricultural-services/',news:'/agricultural-news/'})[key]||'/agriculture-resources/';}
  function render(){
    const q=input.value.trim().toLowerCase();
    const words=q.split(/\s+/).filter(Boolean);
    const countryRows=data.filter(x=>{
      if(!words.length) return true;
      const hay=[x.country,x.code,(x.topics||[]).join(' '),Object.keys(x.sections||{}).join(' ')].join(' ').toLowerCase();
      return words.some(w=>hay.includes(w));
    }).map(x=>({kind:'country',country:x.country,title:x.country,section:'',text:x.topics.join(', '),url:'',total:x.total,sections:x.sections}));
    const recordRows=records.filter(x=>{
      if(!words.length) return false;
      const hay=[x.title,x.country,x.country_code,x.section,x.text].join(' ').toLowerCase();
      return words.some(w=>hay.includes(w));
    }).map(x=>({kind:'record',country:x.country,title:x.title,section:x.section,text:x.text,url:x.url,total:0,sections:{}}));
    const rows=(q ? [...recordRows,...countryRows] : countryRows).slice(0,60);
    out.innerHTML=rows.length ? rows.map(x=>{
      if(x.kind==='record'){
        const destination=x.url||sectionUrl(x.section);
        const title='<a href="'+esc(destination)+'"'+(x.url?' target="_blank" rel="noopener noreferrer"':'')+'>'+esc(x.title)+'</a>';
        return '<article class="card" style="margin:0 0 12px;padding:16px;"><h2 style="margin-top:0;">'+title+'</h2><p>'+esc(x.country)+' · '+esc(sectionLabel(x.section))+'</p><p>'+esc(x.text)+'</p></article>';
      }
      const links=Object.entries(x.sections).map(([k,n])=>'<a href="'+sectionUrl(k)+'">'+esc(sectionLabel(k))+' ('+n+')</a>').join(' · ');
      return '<article class="card" style="margin:0 0 12px;padding:16px;"><h2 style="margin-top:0;">'+esc(x.country)+'</h2><p><strong>'+x.total+'</strong> '+esc(t('recordCount',{count:x.total},x.total+' connected intelligence records'))+'</p><p>'+links+'</p></article>';
    }).join('') : '<p>'+esc(t('noResults',{},'No connected intelligence found. Try a country name, topic, section or record title.'))+'</p>';
  }
  function renderTopics(){
    topicOut.innerHTML=topics.map(item=>'<div class="card" style="padding:14px;"><strong>'+esc(topicLabel(item.key,item.label))+'</strong><br><span style="font-size:.85rem;">'+esc(t('topicCount',{count:item.total},item.total+' connected records'))+'</span><br><span style="font-size:.8rem;">'+Object.entries(item.sections).map(([k,n])=>esc(sectionLabel(k))+' '+n).join(' · ')+'</span></div>').join('');
  }
  function updateTitle(){document.title=t('title',{},'Agricultural Intelligence Hub')+' | GoOrganicAfrica';}
  input.addEventListener('input',render);
  document.addEventListener('goa:languagechange',()=>{render();renderTopics();updateTitle();});
  try {
    render();
    renderTopics();
    updateTitle();
  } catch (error) {
    out.innerHTML = '<p role="status">Search could not load. Please reload this page and try again.</p>';
    console.error('Agricultural Intelligence Hub initialization failed:', error);
  }
})();
</script>
