---
layout: layouts/base.njk
title: Agricultural Intelligence Hub
permalink: /agricultural-intelligence/
---

<div class="container" style="padding-top:2rem;padding-bottom:3rem;">
  <div class="section-head">
    <span class="eyebrow">Connected Agriculture</span>
    <h1>Agricultural Intelligence Hub</h1>
    <p class="lede">Connect countries with agricultural resources, markets, opportunities, services and news so you can move from information to action.</p>
  </div>
  <div style="margin:1.25rem 0;">
    <label for="ai-search"><strong>Search connected intelligence</strong></label>
    <input id="ai-search" type="search" placeholder="Try Nigeria, maize, finance, irrigation, machinery..." aria-label="Search connected agricultural intelligence" style="width:100%;max-width:720px;padding:12px;border:1px solid var(--line);border-radius:10px;margin-top:6px;">
    <p style="margin:.5rem 0 0;">Search by country or topic, then open the matching section. For a full record-by-record search, use <a href="/search/">Global Agricultural Search</a>.</p>
  </div>
  <div id="ai-results"></div>
  <div style="margin-top:2rem;">
    <h2>Value-chain & topic connections</h2>
    <p>These connections are generated only where the same topic appears in real indexed records. Select a topic to search across the connected sections.</p>
    <div id="ai-topics" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;"></div>
  </div>
</div>

<script>
(function(){
  const data = {{ agriculturalKnowledgeConnections.records | jsonify }};
  const topics = {{ agriculturalTopicConnections.topics | jsonify }};
  const input = document.getElementById('ai-search'), out = document.getElementById('ai-results');
  const labels = {resources:'Resources',markets:'Markets',opportunities:'Opportunities',services:'Services & Machinery',news:'Agricultural News'};
  function esc(s){return String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));}
  function render(){
    const q=input.value.trim().toLowerCase();
    const words=q.split(/\s+/).filter(Boolean);
    const rows=data.filter(x=>{
      if(!words.length) return true;
      const hay=(x.country+' '+x.topics.join(' ')).toLowerCase();
      return words.every(w=>hay.includes(w));
    }).slice(0,54);
    out.innerHTML=rows.length ? rows.map(x=>{
      const links=Object.entries(x.sections).map(([k,n])=>'<a href="/search/?q='+encodeURIComponent(x.country)+'" style="text-decoration:none;">'+esc(labels[k]||k)+' ('+n+')</a>').join(' · ');
      return '<article class="card" style="margin:0 0 12px;padding:16px;"><h2 style="margin-top:0;">'+esc(x.country)+'</h2><p><strong>'+x.total+'</strong> connected intelligence records</p><p>'+links+'</p></article>';
    }).join('') : '<p>No connected intelligence found. Try a country name or broader topic.</p>';
  }
  const topicOut=document.getElementById('ai-topics');
  const sectionLabels={markets:'Markets',opportunities:'Opportunities',resources:'Resources',services:'Services & Machinery',news:'Agricultural News'};
  topicOut.innerHTML=topics.map(t=>'<a class="card" href="/search/?q='+encodeURIComponent(t.key)+'" style="text-decoration:none;padding:14px;"><strong>'+esc(t.label)+'</strong><br><span style="font-size:.85rem;">'+t.total+' connected records</span><br><span style="font-size:.8rem;">'+Object.entries(t.sections).map(([k,n])=>esc(sectionLabels[k]||k)+' '+n).join(' · ')+'</span></a>').join('');
  input.addEventListener('input',render); render();
})();
</script>
