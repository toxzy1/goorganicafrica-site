---
layout: layouts/base.njk
title: Agricultural <span data-i18n="static.resources.grantsTitle">Grants & Opportunities</span> | GoOrganicAfrica
description: Agricultural grants and opportunities for African farmers and agribusinesses.
permalink: "/agricultural-grants/"
---
{% include "partials/language-selectors/static.njk" %}
<script>window.GOA_DIRECTORY_TRANSLATIONS = {{ directoryTranslations | dump | safe }};</script>

<section class="section" style="padding-top:48px;">
  <div class="container" style="max-width:900px;">
    <span class="eyebrow"><span data-i18n="static.resources.eyebrow">Farmer Resources</span></span>
    <h1><span data-i18n="static.resources.grantsTitle">Grants & Opportunities</span></h1>
    <p class="lede"><span data-i18n="static.resources.grantsIntro">Grants, subsidies, competitions, youth and women programmes, training and other agricultural opportunities.</span></p>
    <p><span data-i18n="static.resources.grantsText">Verified opportunities are listed below with direct official links. Availability and eligibility can change, so the official source is always the final authority.</span></p>
    <div style="display:grid;gap:18px;margin-top:30px;">
{% for item in directoryListings.listings %}{% if item.type == "grant" and item.active != false %}
      <article class="ebook-card" style="padding:22px;" data-goa-directory-id="{{ item.id }}">
        <h2 style="margin-top:0;" data-goa-directory-field="title">{{ item.title }}</h2>
        <p data-goa-directory-field="description">{{ item.description }}</p>
        <p><strong data-goa-directory-field="country" data-goa-directory-country="{{ item.country }}">{{ item.country }}</strong>{% if item.category %} · <span data-goa-directory-field="category">{{ item.category }}</span>{% endif %}</p>
        {% if item.official_source %}<p><strong data-i18n="static.resources.directoryLabels.officialSource">Official source:</strong> <span data-goa-directory-source="{{ item.official_source }}">{{ item.official_source }}</span></p>{% endif %}
        {% if item.verification_date %}<p><strong data-i18n="static.resources.directoryLabels.verified">Verified:</strong> {{ item.verification_date }}</p>{% endif %}
        {% if item.notes %}<p><small data-goa-directory-field="notes">{{ item.notes }}</small></p>{% endif %}
        {% if item.url %}<p><a href="{{ item.url }}"><span data-i18n="static.resources.directoryLabels.open">Open official resource</span></a></p>{% endif %}
      </article>
{% endif %}{% endfor %}
    </div>
  </div>
</section>
