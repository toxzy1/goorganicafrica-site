---
layout: layouts/base.njk
title: Agricultural Grants & Opportunities | GoOrganicAfrica
description: Find agricultural grants, subsidies, competitions, youth programmes, women programmes and other funding opportunities for farmers and agribusinesses.
permalink: "/agricultural-grants/"
---
{% set opportunities = agriculturalGrants.opportunities | default([]) %}
{% set active = opportunities | selectattr("active","equalto",true) | list %}
<section class="section" style="padding-top:48px;"><div class="container" style="max-width:1050px;">
<span class="eyebrow">Opportunity Directory</span><h1>Agricultural Grants & Opportunities</h1>
<p class="lede">A maintained directory for grants, subsidies, competitions, youth programmes, women-in-agriculture opportunities, cooperative support and related agricultural funding.</p>
<div data-directory-filter style="margin-top:28px;padding:20px;border:1px solid var(--line);border-radius:12px;">
<label for="grant-search"><strong>Search grants & opportunities</strong></label>
<input id="grant-search" data-filter-search type="search" placeholder="Search by opportunity, provider, country or keyword" style="width:100%;margin-top:8px;padding:12px;border:1px solid var(--line);border-radius:8px;">
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px;margin-top:12px;">
<select data-filter-country aria-label="Filter by country" style="padding:11px;border:1px solid var(--line);border-radius:8px;"><option value="">All countries</option>{% for item in active %}<option value="{{ item.country }}">{{ item.country }}</option>{% endfor %}</select>
<select data-filter-category aria-label="Filter by opportunity type" style="padding:11px;border:1px solid var(--line);border-radius:8px;"><option value="">All opportunity types</option><option value="grant">Grant</option><option value="subsidy">Subsidy</option><option value="competition">Competition</option><option value="youth_program">Youth programme</option><option value="women_program">Women programme</option><option value="cooperative_support">Cooperative support</option><option value="training">Training</option><option value="other">Other</option></select>
<select data-filter-status aria-label="Filter by verification status" style="padding:11px;border:1px solid var(--line);border-radius:8px;"><option value="">All published statuses</option><option value="verified">Verified</option></select>
</div><p style="margin:12px 0 0;"><strong data-filter-count>{{ active | length }} listings</strong></p></div>
<div style="display:grid;gap:18px;margin-top:22px;">
{% for item in active %}{% if item.verification_status == "verified" %}
<article data-directory-item data-country="{{ item.country }}" data-category="{{ item.type }}" data-status="{{ item.verification_status }}" data-search="{{ item.title }} {{ item.provider }} {{ item.country }} {{ item.type }} {{ item.supports }} {{ item.eligibility }}" style="padding:22px;border:1px solid var(--line);border-radius:12px;">
<h2 style="margin-top:0;">{{ item.title }}</h2><p><strong>{{ item.provider }}</strong> · {{ item.country }}{% if item.region %} · {{ item.region }}{% endif %}</p>
<p><strong>Type:</strong> {{ item.type | replace("_"," ") }}</p><p>{{ item.supports }}</p>
{% if item.amount %}<p><strong>Amount / benefit:</strong> {{ item.amount }}</p>{% endif %}{% if item.eligibility %}<p><strong>Eligibility:</strong> {{ item.eligibility }}</p>{% endif %}{% if item.deadline %}<p><strong>Deadline:</strong> {{ item.deadline }}</p>{% endif %}
<p style="font-size:.9rem;"><strong>Status:</strong> {{ item.verification_status }}{% if item.last_verified %} · <strong>Last verified:</strong> {{ item.last_verified | replace("T"," ") | replace("Z","") }}{% endif %}</p>
{% if item.application_url %}<a class="btn btn-primary" href="{{ item.application_url }}" target="_blank" rel="noopener noreferrer">Apply / Official Page</a>{% elif item.official_url %}<a class="btn btn-primary" href="{{ item.official_url }}" target="_blank" rel="noopener noreferrer">Official Source</a>{% endif %}
</article>{% endif %}{% endfor %}</div>
<div data-filter-empty hidden style="margin-top:22px;padding:24px;border:1px solid var(--line);border-radius:12px;"><h2>No matching opportunities</h2><p>Try another country, type or search term.</p></div>
<p style="margin-top:28px;"><a href="/agriculture-resources/">← Back to Agricultural Resources</a></p></div></section>
<script src="/js/directory-filter.js" defer></script>