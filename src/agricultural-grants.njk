---
layout: layouts/base.njk
title: Agricultural Grants & Opportunities | GoOrganicAfrica
description: Find agricultural grants, subsidies, competitions, youth programmes, women programmes and other funding opportunities for farmers and agribusinesses.
permalink: "/agricultural-grants/"
---
{% set opportunities = agriculturalGrants.opportunities | default([]) %}
<section class="section" style="padding-top:48px;"><div class="container" style="max-width:1000px;">
<span class="eyebrow">Opportunity Directory</span><h1>Agricultural Grants & Opportunities</h1>
<p class="lede">A maintained directory for grants, subsidies, competitions, youth programmes, women-in-agriculture opportunities, cooperative support and related agricultural funding opportunities.</p>
{% set active = opportunities | selectattr("active","equalto",true) | list %}
{% if active | length %}<div style="display:grid;gap:18px;margin-top:28px;">{% for item in active %}{% if item.verification_status == "verified" %}<article style="padding:22px;border:1px solid var(--line);border-radius:12px;"><h2 style="margin-top:0;">{{ item.title }}</h2><p><strong>{{ item.provider }}</strong> · {{ item.country }}{% if item.region %} · {{ item.region }}{% endif %}</p><p>{{ item.supports }}</p>{% if item.amount %}<p><strong>Benefit:</strong> {{ item.amount }}</p>{% endif %}{% if item.eligibility %}<p><strong>Eligibility:</strong> {{ item.eligibility }}</p>{% endif %}{% if item.deadline %}<p><strong>Deadline:</strong> {{ item.deadline }}</p>{% endif %}{% if item.application_url %}<a class="btn btn-primary" href="{{ item.application_url }}" target="_blank" rel="noopener noreferrer">Apply / Official Page</a>{% endif %}</article>{% endif %}{% endfor %}</div>{% else %}<div style="margin-top:28px;padding:24px;border:1px solid var(--line);border-radius:12px;"><h2>No verified opportunities are published yet</h2><p>Funding opportunities change frequently. We will publish opportunities only after checking the official source and recording a verification status.</p></div>{% endif %}
<p style="margin-top:28px;"><a href="/agriculture-resources/">← Back to Agricultural Resources</a></p></div></section>
