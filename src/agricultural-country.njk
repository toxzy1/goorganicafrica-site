---
layout: layouts/base.njk
pagination:
  data: directoryCountryCoverage.countries
  size: 1
  alias: country
permalink: "/agricultural-resources/countries/{{ country.code | lower }}/"
---
{% include "partials/language-selectors/static.njk" %}
{% set countryListings = directoryListings.listings | selectattr("country", "equalto", country.name) | selectattr("active") | list %}
{% set multiListings = directoryListings.listings | selectattr("country", "equalto", "MULTI") | selectattr("active") | list %}
<section class="section" style="padding-top:48px;">
  <div class="container" style="max-width:1100px;">
    <span class="eyebrow" data-i18n="static.countryDirectory.countryEyebrow">GoOrganicAfrica Resources</span>
    <h1><span data-i18n="static.countryDirectory.countryTitle">Agricultural Resources in</span> <span data-goa-country-name="{{ country.code | lower }}">{{ country.name }}</span></h1>
    <p class="lede" data-i18n="static.countryDirectory.countryIntro">Verified agricultural finance, grants and machinery resources available for this country, together with relevant multi-country African programmes. Country-specific coverage is expanded as official sources are verified.</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap;margin:24px 0;">
      <span class="resource-badge"><span data-i18n="static.countryDirectory.coverage">Country coverage:</span>
        {% if country.coverage_status == "source_registered" %}
          <span data-i18n="static.countryDirectory.statusSourceRegistered">Source registered</span>
        {% elif country.coverage_status == "active_monitoring" %}
          <span data-i18n="static.countryDirectory.statusActiveMonitoring">Active monitoring</span>
        {% else %}
          <span data-i18n="static.countryDirectory.statusNeedsReview">Country source review needed</span>
        {% endif %}
      </span>
      <span class="resource-badge">{{ countryListings | length }} <span data-i18n="static.countryDirectory.countrySpecificListings">country-specific listings</span></span>
      <span class="resource-badge">{{ multiListings | length }} <span data-i18n="static.countryDirectory.multiCountryListings">multi-country listings</span></span>
    </div>

    {% if countryListings | length %}
      <h2 data-i18n="static.countryDirectory.countrySpecificTitle">Country-specific resources</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;margin:20px 0 36px;">
        {% for item in countryListings %}
          <article class="ebook-card" data-goa-directory-id="{{ item.id }}">
            <h3 data-goa-directory-field="title">{{ item.title }}</h3>
            <p data-goa-directory-field="description">{{ item.description }}</p>
            <p><strong data-goa-directory-field="category">{{ item.category }}</strong></p>
            <p><small><span data-i18n="static.resources.directoryLabels.officialSource">Official source:</span> <span data-goa-directory-field="official_source">{{ item.official_source }}</span><br><span data-i18n="static.resources.directoryLabels.verified">Verified:</span> {{ item.verification_date }}</small></p>
            <a class="btn btn-primary" href="{{ item.url }}" target="_blank" rel="noopener noreferrer" data-i18n="static.resources.directoryLabels.open">View official resource</a>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div style="padding:22px;border:1px solid var(--line);border-radius:12px;margin:24px 0;">
        <h2 data-i18n="static.countryDirectory.reviewTitle">Country-specific sources are still being verified</h2>
        <p data-i18n="static.countryDirectory.reviewText">This country already has a permanent place in the GoOrganicAfrica 54-country directory. The automated monitoring system will flag verified government, ministry, agency and development-institution sources for review rather than inventing or publishing unverified information.</p>
      </div>
    {% endif %}

    <h2 data-i18n="static.countryDirectory.multiCountryTitle">Relevant multi-country resources</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;margin:20px 0;">
      {% for item in multiListings %}
        <article class="ebook-card" data-goa-directory-id="{{ item.id }}">
          <h3 data-goa-directory-field="title">{{ item.title }}</h3>
          <p data-goa-directory-field="description">{{ item.description }}</p>
          <p><strong data-goa-directory-field="category">{{ item.category }}</strong></p>
          <p><small><span data-i18n="static.resources.directoryLabels.officialSource">Official source:</span> <span data-goa-directory-field="official_source">{{ item.official_source }}</span><br><span data-i18n="static.resources.directoryLabels.verified">Verified:</span> {{ item.verification_date }}</small></p>
          <a class="btn btn-primary" href="{{ item.url }}" target="_blank" rel="noopener noreferrer" data-i18n="static.resources.directoryLabels.open">View official resource</a>
        </article>
      {% endfor %}
    </div>
    <p style="margin-top:32px;"><a href="/agriculture-resources/" data-i18n="static.countryDirectory.backToResources">← Back to Agricultural Resources</a></p>
  </div>
</section>